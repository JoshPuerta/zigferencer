// linear_q4_0_batch: the batched Q4_0 matmul, (B, K) f32 input times (N, K) weight to (B, N) f32.
//
// What
//   This is the Q4_0 sibling of `linear_q8_0_batch.comp`. The LDS input staging and the tail-lane
//   handling are the same. Only the dequant changes, from 8-bit bytes to 4-bit nibbles, so the
//   quants buffer is half the size. The Q8_0 sibling uses B_TILE = 16, so this kernel holds half
//   as many batch rows per workgroup and streams the weights twice as often for the same B.
//
// Math
//   C[B, N] = A[B, K] @ dequant(W[N, K])^T, with A and C in f32:
//
//     C[b][n] = sum_blk sum_i A[b][blk * 32 + i] * q[n][blk][i]
//     q[n][blk][i] = scale[n][blk] * (nibble[n][blk][i] - 8)
//
//   The ggml Q4_0 block packs each 32-weight block into 16 bytes, which is 4 uint32 words. Weight
//   i (i < 16) is the low nibble of byte i, and weight i + 16 is the high nibble of byte i.
//
// Schedule
//   grid       (ceil(N / N_TILE), ceil(B / B_TILE), 1)
//   workgroup  N_TILE = 32 lanes. One B_TILE = 8 by N_TILE = 32 output tile.
//   lane       Lane l owns one weight column n_out = n_base + l and computes B_TILE outputs for it.
//
//     n_base = wg_n * N_TILE      b_base = wg_b * B_TILE      l = local id
//
//                  n_out:  n_base+0  n_base+1   ...   n_base+31
//                         +---------+---------+     +----------+
//     row b_base + 0      | lane 0  | lane 1  | ... | lane 31  |
//          ...            |   ...   |   ...   |     |   ...    |
//     row b_base + 7      | lane 0  | lane 1  | ... | lane 31  |
//                         +---------+---------+     +----------+
//
//   Each block blk of K / K_TILE runs passes 1 to 3, and pass 4 runs once at the end:
//
//     pass 1  stage     each lane loads one column of the input tile into LDS
//     pass 2  dequant   each active lane dequantizes its weight block into 32 registers
//     pass 3  multiply  each active lane sweeps the 8 rows of the tile and adds into row partials
//     pass 4  write     each active lane stores its partials, skipping the tail rows
//
// Memory
//   LDS at B_TILE = 8 and K_TILE = 32. The driver limit is 32 KiB.
//
//     lds_input  [B_TILE * K_TILE] f32  1 KiB  one K_TILE of inputs across all B_TILE rows
//
// Hardware
//   Waves: local_size_x = N_TILE = 32 is one wave32 wave. The host pins the subgroup size to 32
//   through VK_EXT_subgroup_size_control.
//   Pass 1: the input is f32, and only the weights are quantized.
//   Tails: tail lanes (n_out >= n) still take part in the cooperative LDS load and the barrier,
//   which need uniform control flow across the wave. The weight read, the accumulate, and the
//   store gate on `lane_active` instead.
//
// Numerics
//   Tolerance: `LinearQ40Batch` declares `.relative = 2e-4`. The reduction order and the FMA fusion
//   match `linear_q8_0_batch.comp`, so the result is not bit-exact. A row adds one dot product per
//   block, blk ascending, and i ascending inside it.
//
// Bindings
//   0     readonly   f32   input[B * k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 8) * n]
//   3     writeonly  f32   out[B * n]
//   push  uint b, uint k, uint n
//
// Defines
//   B_TILE  batch rows of one tile, from `limits.q4_batch_b_tile`
//   N_TILE  output columns and lanes of one tile, from `limits.q4_batch_n_tile`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// -- configuration ----------------------------------------------------------
// The host grid arithmetic reads the same two values, B_TILE and N_TILE, from the shader table.
// K_TILE has no host twin, because it is the Q4_0 block length.
#if !defined(B_TILE) || !defined(N_TILE)
#error "B_TILE and N_TILE must come from the build (the vulkan_shaders table)"
#endif
#define K_TILE 32u

layout(local_size_x = N_TILE, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint b;
    uint k;
    uint n;
} params;

shared float lds_input[B_TILE * K_TILE];  // [bi * K_TILE + i]

// -- main -------------------------------------------------------------------
void main() {
    uint wg_n = gl_WorkGroupID.x;
    uint wg_b = gl_WorkGroupID.y;
    uint local = gl_LocalInvocationID.x;

    uint b_base = wg_b * B_TILE;
    uint n_base = wg_n * N_TILE;
    uint n_out = n_base + local;

    // A lane past the output tail must not return, because it still owns a column of LDS.
    bool lane_active = (n_out < params.n);

    uint blocks_per_row = params.k / K_TILE;
    uint words_per_row = params.k / 8u;  // 4 words (16 bytes) per block

    float partials[B_TILE];
    for (uint i = 0u; i < B_TILE; ++i) {
        partials[i] = 0.0;
    }

    for (uint blk = 0u; blk < blocks_per_row; ++blk) {
        // Pass 1: stage one input column per lane. All lanes take part, tail lanes included.
        for (uint bi = 0u; bi < B_TILE; ++bi) {
            uint b = b_base + bi;
            float v = 0.0;
            if (b < params.b) {
                v = input_buf.data[b * params.k + blk * K_TILE + local];
            }

            lds_input[bi * K_TILE + local] = v;
        }
        barrier();

        // Pass 2: dequantize the 32-weight block of this lane into registers from 4 uints.
        if (lane_active) {
            float scale = float(scales_buf.data[n_out * blocks_per_row + blk]);
            uint word_base = n_out * words_per_row + blk * 4u;

            float q[K_TILE];
            for (uint i = 0u; i < 16u; ++i) {
                uint word = quants_buf.data[word_base + (i >> 2)];
                uint shift = (i & 3u) * 8u;
                int lo = int((word >> shift) & 0xFu) - 8;
                int hi = int((word >> (shift + 4u)) & 0xFu) - 8;
                q[i] = scale * float(lo);
                q[i + 16u] = scale * float(hi);
            }

            // Pass 3: add one dot product per row to its partial.
            for (uint bi = 0u; bi < B_TILE; ++bi) {
                uint b = b_base + bi;
                if (b >= params.b) continue;

                float acc = 0.0;
                for (uint i = 0u; i < K_TILE; ++i) {
                    acc += lds_input[bi * K_TILE + i] * q[i];
                }

                partials[bi] += acc;
            }
        }
        barrier();
    }

    // Pass 4: write the partials of this lane. A row past the tail has no output.
    if (lane_active) {
        for (uint bi = 0u; bi < B_TILE; ++bi) {
            uint b = b_base + bi;
            if (b >= params.b) continue;

            out_buf.data[b * params.n + n_out] = partials[bi];
        }
    }
}
