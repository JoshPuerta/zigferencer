// Gated RMSNorm for the chunked GDN prefill of Qwen3.5. It runs after
// `gdn_chunk_scan.comp`, which writes the raw readout of every column. The norm
// couples all D columns of one value head, and the scan splits a head across
// workgroups, so the norm needs its own dispatch.
//
// One workgroup runs per (value head, token) at local_size_x = D (128), with lane
// j as the value-dim index. gl_WorkGroupID.x is the value head and
// gl_WorkGroupID.y is the token. Every lane sums the squares in ascending jj, the
// order of the sequential path, and scales its own element in place.
//
// The pipeline uses the descriptor set layout of the scan, so the caller binds
// one set for both dispatches.
//
//   7  ssm_norm[D]         readonly  gated-RMSNorm weight
//   8  z[T*value_dim]      readonly  output-gate projection
//   10 o_out[T*value_dim]  in/out    raw readout in, normed and gated readout out
//   push  uint D, n_k, n_v, n_tokens, float eps

#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 7)  readonly buffer B7  { float ssm_norm[]; };
layout(std430, set = 0, binding = 8)  readonly buffer B8  { float z[]; };
layout(std430, set = 0, binding = 10)          buffer B10 { float o_out[]; };

layout(push_constant) uniform Params {
    uint  D;
    uint  n_k;
    uint  n_v;
    uint  n_tokens;
    float eps;
} p;

shared float osh[128];            // the raw readout row of this (head, token)

// -- helpers ----------------------------------------------------------------
float silu(float x)     { return x / (1.0 + exp(-x)); }

// -- main -------------------------------------------------------------------
void main() {
    uint vh = gl_WorkGroupID.x;
    uint t  = gl_WorkGroupID.y;
    uint j  = gl_LocalInvocationID.x;
    uint D = p.D;
    uint value_dim = p.n_v * D;
    uint idx = t * value_dim + vh * D + j;

    float orj = o_out[idx];
    osh[j] = orj;
    barrier();
    float sso = 0.0;
    for (uint jj = 0u; jj < D; jj++) sso += osh[jj] * osh[jj];
    float inv = inversesqrt(sso / float(D) + p.eps);
    float zr = z[idx];
    o_out[idx] = orj * inv * ssm_norm[j] * silu(zr);
}
