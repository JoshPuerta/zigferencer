// linear_q8_0_subgroup: the Q8_0 matvec with staged input and a `subgroupAdd` reduction.
//
// What
//   This is the third Q8_0 matvec. It shares the shape and the tolerance class of
//   `linear_q8_0_reduce.comp`, one workgroup per output j and 32 lanes that reduce the row. It has
//   two changes: every multiply reads the input from LDS, and the reduction is a single
//   `subgroupAdd` instead of an LDS store, a barrier, and a sequential sum in lane 0. This variant
//   exists to test whether one `subgroupAdd` beats the LDS round trip. The bench row decides.
//
// Math
//   Here input_lds[blk] is the 32 elements at blk * 32, and blk runs over the k / 32 blocks:
//
//     input_lds[i] = input[i]
//     partial[L]   = sum_{blk % 32 = L} input_lds[blk] . dequant(weight[j][blk])
//     out[j]       = subgroupAdd(partial[L])
//
//   Each block belongs to exactly one lane, so the partials cover the row once.
//
// Schedule
//   grid       (min(n, GRID_X), ceil(n / GRID_X), 1)
//   workgroup  32 lanes. One workgroup owns one output j = gl_WorkGroupID.y * GRID_X +
//              gl_WorkGroupID.x, so a vocabulary past one axis of the grid folds onto y.
//   lane       Lane L stages the input elements L, L + 32, ... and owns the blocks L, L + 32, ...
//
//   gl_WorkGroupID is uniform across the workgroup, so either every lane returns at the guard
//   or none does. All lanes or no lanes reach the cooperative LDS load and the barrier.
//
//     pass 1  stage   each lane copies its strided input elements to LDS
//     pass 2  sum     each lane sums its strided blocks against the LDS input
//     pass 3  reduce  `subgroupAdd` folds the partials, and lane 0 writes out[j]
//
// Memory
//   LDS at LDS_CAPACITY = 4096. The driver limit is 32 KiB.
//
//     input_lds  [LDS_CAPACITY] f32  16 KiB  the input vector
//
//   This covers every shape in the bench except the ffn_down rows (k = 8192 for Llama-1B, k = 14336
//   for Llama-8B). For those the host dispatch returns `error.InFeaturesTooLargeForLdsKernel`, and
//   the bench skips the row. RDNA2 has 64 KB of LDS per CU, so 16 KiB per workgroup still leaves 4
//   workgroups in flight per CU.
//
// Hardware
//   Waves: 32 lanes are one wave32 wave. The kernel expects one subgroup to hold the whole
//   workgroup, because `subgroupAdd` sums only one subgroup. The code cannot force this. The host
//   pins the subgroup size to 32 on the pipeline.
//   Pass 1: a stride of 32 across the lanes keeps the global reads coalesced, because adjacent
//   lanes then read adjacent addresses. Each workgroup reads the k input elements once, as the
//   reduce kernel does, and the reduce lanes read them 128 bytes apart.
//   Pass 3: the reduction runs in the wave, with no LDS store and no barrier.
//
// Numerics
//   Tolerance: `LinearQ80Subgroup` declares `.relative = 2e-4`. `subgroupAdd` reorders the lane
//   partials by hardware-defined rules, so the result is not bit-exact against the CPU reference
//   or against `linear_q8_0_reduce`. Within a lane the accumulation is `precise`, so the partial
//   folds into no FMA, and a lane adds blk and i ascending. The strided block walk and
//   `subgroupAdd` are the two reorders of this variant against the CPU reference.
//
// Bindings
//   0     readonly   f32   input[k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 4) * n]
//   3     writeonly  f32   out[n]
//   push  uint k, uint n
//
//   The host refuses k > LDS_CAPACITY.
//
// Defines
//   LDS_CAPACITY  input elements in LDS, from `limits.subgroup_lds_capacity`
//   GRID_X        workgroups on the x axis, from `limits.reduce_grid_x`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_arithmetic : require

// -- configuration ----------------------------------------------------------
// The shader table gives the same value to the host dispatch that rejects a wider shape.
#ifndef LDS_CAPACITY
#error "LDS_CAPACITY must come from the build (the vulkan_shaders table)"
#endif

#ifndef GRID_X
#error "GRID_X must come from the build (the vulkan_shaders table)"
#endif

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint k;
    uint n;
} params;

shared float input_lds[LDS_CAPACITY];

// -- main -------------------------------------------------------------------
void main() {
    uint local = gl_LocalInvocationID.x;
    uint j = gl_WorkGroupID.y * GRID_X + gl_WorkGroupID.x;
    if (j >= params.n) return;

    uint k = params.k;

    // Pass 1: stage the input into LDS, each lane striding 32 elements.
    for (uint i = local; i < k; i += 32u) {
        input_lds[i] = input_buf.data[i];
    }
    barrier();

    uint blocks_per_row = k / 32u;
    uint words_per_row = k / 4u;

    // Pass 2: sum the strided blocks of this lane against the LDS input.
    precise float partial = 0.0;
    for (uint blk = local; blk < blocks_per_row; blk += 32u) {
        precise float scale = float(scales_buf.data[j * blocks_per_row + blk]);
        uint word_base = j * words_per_row + blk * 8u;

        for (uint i = 0u; i < 32u; ++i) {
            precise float in_v = input_lds[blk * 32u + i];
            uint word = quants_buf.data[word_base + (i >> 2)];
            int q = bitfieldExtract(int(word), int((i & 3u) * 8u), 8);
            precise float in_scale = in_v * scale;
            precise float term = in_scale * float(q);
            partial += term;
        }
    }

    // Pass 3: reduce the partials across the subgroup.
    float sum = subgroupAdd(partial);
    if (local == 0u) {
        out_buf.data[j] = sum;
    }
}
