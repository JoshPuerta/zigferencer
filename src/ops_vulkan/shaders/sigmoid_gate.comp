// Output gate of the Qwen3.5 full-attention block, in place:
//
//   dst[i] = dst[i] * sigmoid(gate[i])
//
// The kernel scales the attention readout by the sigmoid of the gate half of the
// fused query|gate projection. That half is un-normed and un-roped, and the
// scaling runs before the output projection. This is output gating, and it
// differs from the silu(gate) * up of swiglu, which gates the FFN. Lane i owns
// element i at local_size_x = 256.
//
//   binding 0  readwrite f32 dst[n]    (attention output, gated in place)
//   binding 1  readonly  f32 gate[n]
//   push       uint n
//
// GPU `exp` does not round the same as the CPU reference, so the result is not
// bit-exact. The Zig wrapper `SigmoidGate` declares `.relative = 1e-5`.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer DstBuf {
    float data[];
} dst_buf;

layout(std430, set = 0, binding = 1) readonly buffer GateBuf {
    float data[];
} gate_buf;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;
    float g = gate_buf.data[i];
    dst_buf.data[i] = dst_buf.data[i] * (1.0 / (1.0 + exp(-g)));
}
