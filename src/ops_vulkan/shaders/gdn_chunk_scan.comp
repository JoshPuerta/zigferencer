// gdn_chunk_scan: the chunked gated delta-rule scan of Qwen3.5 GDN value heads over T tokens.
//
// What
//   The scan solves the recurrence of one prefill chunk in one dispatch. It mirrors `chunkScan`
//   in ops/gdn.zig. `gdn_chunk_conv.comp` runs first and writes q_n, k_n, and v_conv.
//   `gdn_chunk_norm.comp` runs last, because the gated RMSNorm couples the columns of a head and
//   this kernel splits a head across workgroups. This kernel writes the raw readout to o_out.
//
// Math
//   One token r of the sequential recurrence, with S the D x D state of a value head:
//
//     S'    = decay_r * S
//     delta = beta_r * (v_r - S'^T k_r)
//     S     = S' + k_r (x) delta             (x) is the outer product
//     o_r   = S^T q_r
//
//   Unroll C tokens from the incoming state S_in, with P[r] = prod_{u <= r} decay_u:
//
//     delta_r = beta_r (v_r - P[r] S_in^T k_r) - sum_{s<r} beta_r (P[r]/P[s]) (k_s . k_r) delta_s
//     o_r     = P[r] S_in^T q_r + sum_{s<=r} (P[r]/P[s]) (k_s . q_r) delta_s
//     S_out   = P[C-1] S_in + sum_s (P[C-1]/P[s]) k_s (x) delta_s
//
//   The first line is a strictly lower-triangular solve over r. The kernel works in log space,
//   with g_u = log(decay_u) < 0 and Psh[r] = sum_{u <= r} g_u = log P[r]. So a ratio
//   P[r]/P[s] = exp(Psh[r] - Psh[s]) never divides by an underflowed P, and it is at most 1.
//
// Schedule
//   grid       (n_v * (DH / W), 1, 1)
//   workgroup  W lanes. Workgroup g serves value head vh = g / (DH / W) and block c = g % (DH / W).
//   lane       Lane l owns state column j = c * W + l for the whole chunk.
//
//                  block c = 0       block c = 1             block c = 3
//                +-----------------+-----------------+-----+-----------------+
//     state      | j = 0 .. 31     | j = 32 .. 63    | ... | j = 96 .. 127   |
//                +-----------------+-----------------+-----+-----------------+
//                  workgroup 4vh     workgroup 4vh+1         workgroup 4vh+3
//
//   The chunk runs sub-chunks of C = min(CSUB, T - t0) tokens in order. Each one runs:
//
//     pass 1  stage     lanes copy the k_n and q_n rows to LDS, and lanes l < C compute g and beta
//     pass 2  pairs     lanes fill KK and KQ, one pair r * C + s per step, and rcoef
//     pass 3  delta     each lane starts delta of its column, with no barrier
//     pass 4  solve     each lane runs forward substitution over its column, with no barrier
//     pass 5  readout   each lane writes o_r[j], and this pass reads S_in
//     pass 6  state     each lane computes S_out, then a barrier ends the sub-chunk
//
// Memory
//   LDS at CSUB = 16, W = 32, and DH = 128. `limits.gdnScanLdsBytes` holds the same sum, and the
//   driver limit is 32 KiB.
//
//     ksub, qsub  [CSUB * DH] f32 each     16 KiB   k_n and q_n rows, [r * D + i]
//     dlt         [CSUB * W] f32           2 KiB    delta of the owned columns, [r * W + l]
//     KK, KQ      [CSUB * CSUB] f32 each   2 KiB    k_s . k_r and k_s . q_r, [r * C + s]
//     Psh, glog, bsh, rcoef  [CSUB] f32    256 B    per-token rows
//
// Hardware
//   Waves: W = 32 lanes are one wave32 wave, so a barrier waits for no other wave.
//   Registers: a lane holds column S in registers for the whole chunk. It loads the column once
//   at the start and stores it once at the end. S takes at least 128 VGPRs, so at most 8 waves
//   fit on one SIMD32. A variable index forces the array to scratch memory, so the U128 macro
//   expands each loop over i and every index is a constant. DH is fixed at 128 for that reason.
//   Pass 1: the lanes of a wave read 32 adjacent elements of one row, so the loads coalesce.
//   Passes 2 to 6: LDS and registers, plus one v_conv read per token and one o_out write.
//
// Numerics
//   Tolerance: `GdnChunkParallel` declares `.relative = 1e-4`. The sub-chunk solve reorders the
//   reduction against the sequential recurrence, and the GPU transcendentals differ from the CPU
//   intrinsics. Each output and state element keeps one summation order: i ascending for the dot
//   products, and s ascending for the sums over the sub-chunk. A change of CSUB changes that
//   order. Each workgroup of a head fills KK and KQ in the same order, so all four hold equal
//   values.
//
// Bindings
//   0     readonly   f32  q_n[T * key_dim]       normed and scaled q, [t * key_dim + kh * D + i]
//   1     readonly   f32  k_n[T * key_dim]       normed k
//   2     readonly   f32  v_conv[T * value_dim]  convolved v, [t * value_dim + vh * D + j]
//   3     readonly   f32  alpha[T * n_v]         decay projection
//   4     readonly   f32  beta_in[T * n_v]       delta-strength projection
//   5     readonly   f32  ssm_a[n_v]             already -exp(A_log)
//   6     readonly   f32  dt_bias[n_v]
//   7     unused     f32  ssm_norm[D]            the norm pass reads it
//   8     unused     f32  z[T * value_dim]       the norm pass reads it
//   9     readwrite  f32  state[n_v * D * D]     recurrent state, [vh * D * D + i * D + j]
//   10    writeonly  f32  o_out[T * value_dim]   raw readout, before the gated norm
//   push  uint D, n_k, n_v, n_tokens, float eps
//
// Defines
//   CSUB  tokens of one sub-chunk, from `limits.gdn_scan_sub`
//   W     state columns and lanes of one workgroup, from `limits.gdn_scan_cols`
//   DH    head width, from `limits.gdn_head_dim`. The U128 expansion needs DH = 128.

#version 450

// -- configuration ----------------------------------------------------------
// U128(M) expands M(0u) .. M(127u) in ascending order.
#define U4(M, b) M((b)) M((b) + 1u) M((b) + 2u) M((b) + 3u)
#define U16(M, b) U4(M, (b)) U4(M, (b) + 4u) U4(M, (b) + 8u) U4(M, (b) + 12u)
#define U128(M) U16(M, 0u) U16(M, 16u) U16(M, 32u) U16(M, 48u) \
                U16(M, 64u) U16(M, 80u) U16(M, 96u) U16(M, 112u)

layout(local_size_x = W, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0)  readonly  buffer B0  { float q_n[]; };
layout(std430, set = 0, binding = 1)  readonly  buffer B1  { float k_n[]; };
layout(std430, set = 0, binding = 2)  readonly  buffer B2  { float v_conv[]; };
layout(std430, set = 0, binding = 3)  readonly  buffer B3  { float alpha[]; };
layout(std430, set = 0, binding = 4)  readonly  buffer B4  { float beta_in[]; };
layout(std430, set = 0, binding = 5)  readonly  buffer B5  { float ssm_a[]; };
layout(std430, set = 0, binding = 6)  readonly  buffer B6  { float dt_bias[]; };
layout(std430, set = 0, binding = 9)            buffer B9  { float state[]; };
layout(std430, set = 0, binding = 10) writeonly buffer B10 { float o_out[]; };

layout(push_constant) uniform Params {
    uint  D;
    uint  n_k;
    uint  n_v;
    uint  n_tokens;
    float eps;
} p;

shared float ksub[CSUB * DH];
shared float qsub[CSUB * DH];
shared float dlt[CSUB * W];
shared float KK[CSUB * CSUB];
shared float KQ[CSUB * CSUB];
shared float Psh[CSUB];    // log P[r]
shared float glog[CSUB];   // log(decay) of each token
shared float bsh[CSUB];    // beta of each token
shared float rcoef[CSUB];  // exp(Psh[C-1] - Psh[s]), the state-update ratios

// -- helpers ----------------------------------------------------------------
float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }
float softplusf(float x) { return (x > 20.0) ? x : log(1.0 + exp(x)); }

// -- main -------------------------------------------------------------------
void main() {
    uint vh = gl_WorkGroupID.x / (DH / W);
    uint c = gl_WorkGroupID.x % (DH / W);
    uint l = gl_LocalInvocationID.x;
    uint j = c * W + l;  // the state column of this lane
    uint nk = p.n_k;
    uint nv = p.n_v;
    uint T = p.n_tokens;
    uint ki = vh % nk;   // the key head of this value head
    uint key_dim = nk * DH;
    uint value_dim = nv * DH;
    uint sbase = vh * DH * DH;

    float S[DH];
#define LOAD_S(i) S[i] = state[sbase + (i) * DH + j];
    U128(LOAD_S)

    uint t0 = 0u;
    while (t0 < T) {
        uint C = min(CSUB, T - t0);

        // Pass 1: stage the k_n and q_n rows of key head ki, then g and beta of each token.
        for (uint e = l; e < C * DH; e += W) {
            uint r = e / DH;
            uint i = e % DH;
            ksub[e] = k_n[(t0 + r) * key_dim + ki * DH + i];
            qsub[e] = q_n[(t0 + r) * key_dim + ki * DH + i];
        }

        if (l < C) {
            uint t = t0 + l;
            glog[l] = ssm_a[vh] * softplusf(alpha[t * nv + vh] + dt_bias[vh]);
            bsh[l] = sigmoidf(beta_in[t * nv + vh]);
        }
        barrier();

        if (l == 0u) {
            float acc = 0.0;
            for (uint r = 0u; r < C; r++) {
                acc += glog[r];
                Psh[r] = acc;
            }
        }
        barrier();

        // Pass 2: KK[r, s] = k_s . k_r and KQ[r, s] = k_s . q_r, the lanes striding r * C + s.
        // The state-update ratios depend on Psh alone, so they share this step.
        for (uint pr = l; pr < C * C; pr += W) {
            uint r = pr / C;
            uint s = pr % C;
            float akk = 0.0;
            float akq = 0.0;
            for (uint i = 0u; i < DH; i++) {
                float ks = ksub[s * DH + i];
                akk += ks * ksub[r * DH + i];
                akq += ks * qsub[r * DH + i];
            }

            KK[r * C + s] = akk;
            KQ[r * C + s] = akq;
        }

        if (l < C) rcoef[l] = exp(Psh[C - 1u] - Psh[l]);
        barrier();

        // Pass 3: dlt[r, l] = beta_r (v_r[j] - P[r] (S_in^T k_r)[j]).
        for (uint r = 0u; r < C; r++) {
            float sk = 0.0;
#define SK_STEP(i) sk += S[i] * ksub[r * DH + (i)];
            U128(SK_STEP)
            float vr = v_conv[(t0 + r) * value_dim + vh * DH + j];
            dlt[r * W + l] = bsh[r] * (vr - exp(Psh[r]) * sk);
        }

        // Pass 4: dlt[r, l] -= sum_{s<r} beta_r exp(Psh[r] - Psh[s]) KK[r, s] dlt[s, l].
        for (uint r = 1u; r < C; r++) {
            float acc = dlt[r * W + l];
            for (uint s = 0u; s < r; s++) {
                acc -= bsh[r] * exp(Psh[r] - Psh[s]) * KK[r * C + s] * dlt[s * W + l];
            }

            dlt[r * W + l] = acc;
        }

        // Pass 5: o_r[j] = P[r] (S_in^T q_r)[j] + sum_{s<=r} (P[r]/P[s]) KQ[r, s] dlt[s, l].
        // It reads S_in, so it runs before pass 6.
        for (uint r = 0u; r < C; r++) {
            float sq = 0.0;
#define SQ_STEP(i) sq += S[i] * qsub[r * DH + (i)];
            U128(SQ_STEP)
            float orj = exp(Psh[r]) * sq;
            for (uint s = 0u; s <= r; s++) {
                orj += exp(Psh[r] - Psh[s]) * KQ[r * C + s] * dlt[s * W + l];
            }

            o_out[(t0 + r) * value_dim + vh * DH + j] = orj;
        }

        // Pass 6: S_out[i, j] = P[C-1] S_in[i, j] + sum_s (P[C-1]/P[s]) k_s[i] dlt[s, l].
        // The s loop sits outside the i expansion, and each element still adds in ascending s.
        float pfac = exp(Psh[C - 1u]);
#define DECAY_STEP(i) S[i] = S[i] * pfac;
        U128(DECAY_STEP)

        for (uint s = 0u; s < C; s++) {
            float rc = rcoef[s];
            float ds = dlt[s * W + l];
#define UPDATE_STEP(i) S[i] += rc * ksub[s * DH + (i)] * ds;
            U128(UPDATE_STEP)
        }
        barrier();  // every lane is done with ksub, rcoef, and Psh before the next load

        t0 += C;
    }

#define STORE_S(i) state[sbase + (i) * DH + j] = S[i];
    U128(STORE_S)
}
