// linear_q8_0_batch: the batched Q8_0 matmul, (B, K) f32 input times (N, K) weight to (B, N) f32.
//
// What
//   The decode kernel `linear_q8_0_reduce.comp` streams the whole weight from VRAM once per token.
//   This kernel streams it once per B_TILE batch rows, and so amortizes the weight bandwidth across
//   the batch. A b-token prefill at B = 1 makes b forward passes, each with one whole weight read.
//   This kernel takes ceil(b / B_TILE) weight reads for the same tokens, which is the
//   time-to-first-token win it targets.
//
// Math
//   C[B, N] = A[B, K] @ dequant(W[N, K])^T, with A and C in f32:
//
//     C[b][n] = sum_blk sum_i A[b][blk * 32 + i] * q[n][blk][i]
//     q[n][blk][i] = scale[n][blk] * quant[n][blk * 32 + i]
//
//   W is Q8_0: one f16 scale per 32-element block, and i8 quants packed 4 per uint, row-major
//   [N][K]. K is a multiple of 32, and K_TILE = 32 is the Q8_0 block.
//
// Schedule
//   grid       (ceil(N / N_TILE), ceil(B / B_TILE), 1)
//   workgroup  N_TILE = 32 lanes, one wave32 wave. One B_TILE = 16 by N_TILE = 32 output tile.
//   lane       Lane l owns one weight column n_out = n_base + l and computes B_TILE outputs for it.
//
//     n_base = wg_n * N_TILE      b_base = wg_b * B_TILE      l = local id
//
//                  n_out:  n_base+0  n_base+1   ...   n_base+31
//                         +---------+---------+     +----------+
//     row b_base + 0      | lane 0  | lane 1  | ... | lane 31  |
//     row b_base + 1      | lane 0  | lane 1  | ... | lane 31  |
//          ...            |   ...   |   ...   |     |   ...    |
//     row b_base + 15     | lane 0  | lane 1  | ... | lane 31  |
//                         +---------+---------+     +----------+
//
//   Each block blk of K / K_TILE runs passes 1 to 3, and pass 4 runs once at the end:
//
//     pass 1  stage     each lane loads one column of the input tile into LDS
//     pass 2  dequant   each active lane dequantizes its weight block into 32 registers
//     pass 3  multiply  each active lane sweeps the B_TILE rows and adds into per-row partials
//     pass 4  write     each active lane stores its partials, skipping the tail rows
//
// Memory
//   LDS at B_TILE = 16 and K_TILE = 32. The driver limit is 32 KiB, and a CU holds 64 KB.
//
//     lds_input  [B_TILE * K_TILE] f32  2 KiB  one K_TILE of inputs across all B_TILE rows
//
//   A lane caches its weight block in registers and sweeps the rows. That reuse is the whole
//   point, because a b-token prefill then streams the weights only ceil(b / B_TILE) times.
//
// Hardware
//   Occupancy: registers set the knee in B_TILE, not compute. This is a single-wave workgroup
//   that holds many registers per lane, so resident waves are capped, and achieved bandwidth falls
//   as B_TILE grows. B_TILE = 16 sits at that knee. A better result needs the multi-wave
//   register-blocked GEMM, which is `linear_q8_0_gemm.comp`.
//   Pass 1: lanes read adjacent K elements of one row, so the input loads coalesce.
//   Pass 2: each lane reads the 32 contiguous quant bytes of its own block. Adjacent lanes sit k
//   bytes apart, so these loads coalesce inside a lane and not across the wave. The scales[n][blk]
//   loads stride blocks_per_output * 2 bytes across lanes. They do not coalesce, but they are
//   L2-resident at these sizes.
//   Pass 3: all 32 lanes read the same `lds_input[bi * K_TILE + i]`, an LDS broadcast with no bank
//   conflict and no L1 transaction. The K-outer, B-inner loop runs slower.
//   Tails: a `return` past n skips the LDS load and the barrier, and it corrupts the outputs when
//   n % N_TILE != 0. The 2B GDN alpha and beta matmuls hit that case at n = n_v = 16. So
//   `lane_active` gates the weight read, the accumulate, and the store, and b < B gates a row.
//
// Numerics
//   Tolerance: `LinearQ80Batch` declares `.relative = 2e-4`. The per-row accumulation reorders the
//   reduction, and no `precise` marks it, so the device compiler can fuse a multiply and an add
//   into an FMA. A row adds one dot product per block, blk ascending, and i ascending inside it.
//
// Bindings
//   0     readonly   f32   input[B * k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 4) * n]
//   3     writeonly  f32   out[B * n]
//   push  uint b, uint k, uint n
//
// Defines
//   B_TILE  batch rows of one tile, from `limits.q8_batch_b_tile`
//   N_TILE  output columns and lanes of one tile, from `limits.q8_batch_n_tile`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// -- configuration ----------------------------------------------------------
// The host grid arithmetic reads the same two values, B_TILE and N_TILE, from the shader table.
// K_TILE has no host twin, because it is the Q8_0 block length.
#if !defined(B_TILE) || !defined(N_TILE)
#error "B_TILE and N_TILE must come from the build (the vulkan_shaders table)"
#endif
#define K_TILE 32u

layout(local_size_x = N_TILE, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint b;
    uint k;
    uint n;
} params;

shared float lds_input[B_TILE * K_TILE];  // [bi * K_TILE + i]

// -- main -------------------------------------------------------------------
void main() {
    uint wg_n = gl_WorkGroupID.x;
    uint wg_b = gl_WorkGroupID.y;
    uint local = gl_LocalInvocationID.x;

    uint b_base = wg_b * B_TILE;
    uint n_base = wg_n * N_TILE;
    uint n_out = n_base + local;

    // A lane past the output tail must not return, because it still owns a column of LDS.
    bool lane_active = (n_out < params.n);

    uint blocks_per_output = params.k / K_TILE;
    uint words_per_output = params.k / 4u;

    float partials[B_TILE];
    for (uint i = 0u; i < B_TILE; ++i) {
        partials[i] = 0.0;
    }

    for (uint blk = 0u; blk < blocks_per_output; ++blk) {
        // Pass 1: stage one input column per lane. All lanes take part, tail lanes included.
        for (uint bi = 0u; bi < B_TILE; ++bi) {
            uint b = b_base + bi;
            float v = 0.0;
            if (b < params.b) {
                v = input_buf.data[b * params.k + blk * K_TILE + local];
            }

            lds_input[bi * K_TILE + local] = v;
        }
        barrier();

        // Pass 2: dequantize the weight block of this lane into 32 register floats.
        if (lane_active) {
            float scale = float(scales_buf.data[n_out * blocks_per_output + blk]);
            uint word_base = n_out * words_per_output + blk * 8u;

            float q[K_TILE];
            for (uint i = 0u; i < K_TILE; ++i) {
                uint word = quants_buf.data[word_base + (i >> 2)];
                int qi = bitfieldExtract(int(word), int((i & 3u) * 8u), 8);
                q[i] = scale * float(qi);
            }

            // Pass 3: add one dot product per row to its partial.
            for (uint bi = 0u; bi < B_TILE; ++bi) {
                uint b = b_base + bi;
                if (b >= params.b) continue;

                float acc = 0.0;
                for (uint i = 0u; i < K_TILE; ++i) {
                    acc += lds_input[bi * K_TILE + i] * q[i];
                }

                partials[bi] += acc;
            }
        }
        barrier();
    }

    // Pass 4: write the partials of this lane. A row past the tail has no output.
    if (lane_active) {
        for (uint bi = 0u; bi < B_TILE; ++bi) {
            uint b = b_base + bi;
            if (b >= params.b) continue;

            out_buf.data[b * params.n + n_out] = partials[bi];
        }
    }
}
