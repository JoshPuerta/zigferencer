// linear_q8_0_reduce: the Q8_0 decode matvec, one workgroup per output and an LDS reduction.
//
// What
//   This kernel has the result shape of `linear_q8_0.comp` and a different work assignment. That
//   kernel gives one invocation to an output j. This one gives one workgroup to an output j, with
//   32 lanes that sum the row together. That is 32 times more workgroups for the same n and 32
//   times less work per lane. It wins when n is small enough that the per-invocation kernel has
//   too few workgroups to keep the WGPs busy.
//
// Math
//   Here input[blk] is the 32 elements at blk * 32, and blk runs over the k / 32 blocks:
//
//     partial[L] = sum_{blk % 32 = L} input[blk] . dequant(weight[j][blk])
//     out[j]     = sum_{L in 0..31} partial[L]
//
//   Each block belongs to exactly one lane, so the partials cover the row once.
//
// Schedule
//   grid       (min(n, GRID_X), ceil(n / GRID_X), 1)
//   workgroup  32 lanes. One workgroup owns one output j = gl_WorkGroupID.y * GRID_X +
//              gl_WorkGroupID.x, so a vocabulary past one axis of the grid folds onto y.
//   lane       Lane L owns the weight blocks L, L + 32, L + 64, ... of row j.
//
//     lane L sums blocks L, L+32, L+64, ...     (strided, so a wave reads one run)
//           \____________ 32 lane partials ____________/
//                                  |
//                        LDS + barrier, lane 0 sums  ->  out[j]
//
//     pass 1  sum     each lane sums its strided blocks and stores the partial to LDS
//     pass 2  reduce  lane 0 sums the 32 partials and writes out[j]
//
// Memory
//   LDS at 32 lanes. The driver limit is 32 KiB.
//
//     lds_partials  [32] f32  128 B  one partial per lane
//
// Hardware
//   Waves: local_size_x = 32 is one wave32 wave. Every lane of a workgroup is a lane of the same
//   wave, so there is no cross-wave synchronization. The closing `barrier()` that the GLSL spec
//   needs maps to a no-op on the hardware.
//   Pass 1: the strided assignment is deliberate. Adjacent lanes own adjacent weight blocks, so a
//   wave reads one contiguous run of each buffer. The lanes sit 32 bytes apart in the quants, so
//   those loads can share a line, and 128 bytes apart in the input.
//   Pass 2: the reduction is a sequential lane-0 sum of 32 partials. A log-N tree saves little at
//   32 elements.
//   Tails: the last grid row can hold workgroups past n. Such a workgroup still stores a zero
//   partial and reaches the barrier, so every lane leaves through the same barrier.
//
// Numerics
//   Tolerance: `LinearQ80Reduce` declares `.relative = 2e-4`. f32 add is not associative, so the
//   output drifts from the CPU reference even under `precise`. No `precise` marks the inner chain,
//   so the device compiler can fuse `in_v * scale * q + partial` into an FMA. The reduce in lane 0
//   is the irreducible source of the error. A lane adds blk and i ascending, and lane 0 adds
//   L ascending. This order differs from the CPU reference, but it is stable, which the hash gate
//   needs. The bench prints the variants side by side, so its tolerance column shows the drift.
//
// Bindings
//   0     readonly   f32   input[k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 4) * n]
//   3     writeonly  f32   out[n]
//   push  uint k, uint n
//
//   The buffer layouts match `linear_q8_0.comp`.
//
// Defines
//   GRID_X  workgroups on the x axis, from `limits.reduce_grid_x`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// -- configuration ----------------------------------------------------------
// The shader table gives the same value to the host dispatch that sizes the grid.
#ifndef GRID_X
#error "GRID_X must come from the build (the vulkan_shaders table)"
#endif

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint k;
    uint n;
} params;

shared float lds_partials[32];

// -- main -------------------------------------------------------------------
void main() {
    uint j = gl_WorkGroupID.y * GRID_X + gl_WorkGroupID.x;
    uint local = gl_LocalInvocationID.x;
    if (j >= params.n) {
        lds_partials[local] = 0.0;
        barrier();

        return;
    }

    uint blocks_per_row = params.k / 32u;
    uint words_per_row = params.k / 4u;

    // Pass 1: sum the strided blocks of this lane.
    float partial = 0.0;
    for (uint blk = local; blk < blocks_per_row; blk += 32u) {
        float scale = float(scales_buf.data[j * blocks_per_row + blk]);
        uint word_base = j * words_per_row + blk * 8u;

        for (uint i = 0u; i < 32u; ++i) {
            float in_v = input_buf.data[blk * 32u + i];
            uint word = quants_buf.data[word_base + (i >> 2)];
            int q = bitfieldExtract(int(word), int((i & 3u) * 8u), 8);
            partial += in_v * scale * float(q);
        }
    }

    lds_partials[local] = partial;
    barrier();

    // Pass 2: lane 0 sums the partials in lane order.
    if (local == 0u) {
        precise float sum = 0.0;
        for (uint i = 0u; i < 32u; ++i) {
            sum += lds_partials[i];
        }

        out_buf.data[j] = sum;
    }
}
