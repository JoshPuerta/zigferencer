// Q8_0 matvec with the same result shape as `linear_q8_0.comp` and a different
// work assignment. The bit-exact variant gives one INVOCATION per output j. This
// one gives one WORKGROUP per output j, with 32 lanes that sum the row
// cooperatively and an LDS reduction at the end. That is 32 times more workgroups
// for the same n and 32 times less work per lane. It wins exactly when n is small
// enough that the per-invocation variant has too few workgroups to keep the WGPs
// busy.
//
//   out[j] = sum over the (k/32) weight blocks of  input[blk] . weight[j][blk]
//
//   lane L sums blocks L, L+32, L+64, ...     (strided, so the loads coalesce)
//         \____________ 32 lane partials ____________/
//                                |
//                      LDS + barrier, lane 0 sums  ->  out[j]
//
// The strided assignment is deliberate. Adjacent lanes read adjacent weight
// blocks, so the global loads coalesce into full cache lines across the wave
// instead of each lane stranding its own line.
//
//   binding 0  readonly  f32  input[k]                 (layout as linear_q8_0)
//   binding 1  readonly  f16  scales[(k/32) * n]
//   binding 2  readonly  uint quants_packed[(k/4) * n]
//   binding 3  writeonly f32  out[n]
//   push       uint k, uint n
//
// local_size_x = 32 is one RDNA2 wave32. Every lane of a workgroup is a lane of
// the same wave, so there is no cross-wave synchronization, and the closing
// `barrier()` that the GLSL spec needs maps to a no-op on the hardware. The LDS
// reduction is a sequential lane-0 sum of 32 partials. A log-N tree saves little
// at 32 elements, and the sequential form keeps the per-output summation order
// deterministic across runs. That order differs from the scalar CPU reference,
// but it is stable, which the hash gate needs.
//
// Block partials accumulate in lane order and lane 0 then sums them. f32 add is
// not associative, so the output drifts from the CPU reference even under
// `precise`. The Zig wrapper `LinearQ80Reduce` declares `.relative = 2e-4`. The
// bench prints the variants side by side, and the tolerance column shows which
// one drifts and by how much.

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint k;
    uint n;
} params;

shared float lds_partials[32];

// -- main -------------------------------------------------------------------
void main() {
    uint j = gl_WorkGroupID.x;
    uint local = gl_LocalInvocationID.x;
    if (j >= params.n) {
        lds_partials[local] = 0.0;
        barrier();
        return;
    }

    uint blocks_per_row = params.k / 32u;
    uint words_per_row = params.k / 4u;

    // No `precise` on the inner chain: the compiler fuses
    // `in * scale * q + partial` into a hardware FMA, about 33% fewer
    // cycles per inner element. The cross-lane reduce in lane 0 below
    // is the irreducible source of the error against the CPU reference,
    // and the measured relative error stays well under 2e-4.
    float partial = 0.0;
    for (uint blk = local; blk < blocks_per_row; blk += 32u) {
        float scale = float(scales_buf.data[j * blocks_per_row + blk]);
        uint word_base = j * words_per_row + blk * 8u;
        for (uint i = 0u; i < 32u; ++i) {
            float in_v = input_buf.data[blk * 32u + i];
            uint word = quants_buf.data[word_base + (i >> 2)];
            int q = bitfieldExtract(int(word), int((i & 3u) * 8u), 8);
            partial += in_v * scale * float(q);
        }
    }

    lds_partials[local] = partial;
    barrier();

    if (local == 0u) {
        precise float sum = 0.0;
        for (uint i = 0u; i < 32u; ++i) sum += lds_partials[i];
        out_buf.data[j] = sum;
    }
}
