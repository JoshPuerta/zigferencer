// rope: in-place RoPE on one head_dim vector at position pos, one lane per rotated pair.
//
// What
//   The kernel rotates the leading rope_dim dims of x, and dims at or past rope_dim stay
//   untouched. Only the benchmark calls it. The per-op path runs the CPU rope, and the fused
//   runners use `rope_multi.comp`.
//
// Math
//   For pair i in 0 .. rope_dim / 2 - 1, with ff[i] the per-pair frequency factor:
//
//     theta = freq_base^(-2i / rope_dim)
//     angle = pos * theta / ff[i]
//     (x[a], x[b]) = (x[a] cos - x[b] sin, x[a] sin + x[b] cos)
//
//   Pairing follows the rope type of the architecture, in the vocabulary of llama.cpp:
//
//     style_norm = 1  a = 2i, b = 2i + 1      the llama family, adjacent pairs
//     style_norm = 0  a = i, b = i + half     the neox and Qwen family, half = rope_dim / 2
//
//   The GGUF conversion permutes the Q and K weights for the adjacent layout. The wrong style
//   scrambles attention geometry at every position.
//
// Hardware
//   Lane i rotates pair i. 64 lanes are 2 wave32 waves, and the grid is
//   (ceil((rope_dim / 2) / 64), 1, 1). A rope_dim of 64 or 128 takes one workgroup, and 256 takes
//   two. That small size makes per-head RoPE dispatch-overhead bound, which is why the
//   `rope_multi` variant exists. A lane past the last pair returns, and no barrier follows.
//
// Numerics
//   Tolerance: `Rope` declares `.relative = 5e-5`. The GPU `pow`, `cos`, and `sin` round
//   differently from the CPU intrinsics. The kernel has no reduction, so no summation order
//   applies.
//
// Bindings
//   0     readwrite  f32  x[head_dim]       rotated in place
//   1     readonly   f32  ff[rope_dim / 2]  frequency divisors, all ones for classic RoPE
//   push  uint pos, rope_dim, float freq_base, uint style_norm
//   rope_dim must be even and at most the length of x.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer FfBuf {
    float data[];
} ff_buf;

layout(push_constant) uniform Params {
    uint pos;
    uint rope_dim;
    float freq_base;
    uint style_norm;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint half_dim = params.rope_dim / 2u;
    if (i >= half_dim) return;

    float inv_dim = 1.0 / float(params.rope_dim);
    float exp_v = -2.0 * float(i) * inv_dim;
    float theta = pow(params.freq_base, exp_v);
    float angle = float(params.pos) * theta / ff_buf.data[i];
    float cos_v = cos(angle);
    float sin_v = sin(angle);
    uint ia = (params.style_norm == 1u) ? 2u * i : i;
    uint ib = (params.style_norm == 1u) ? 2u * i + 1u : i + half_dim;
    float a = x_buf.data[ia];
    float b = x_buf.data[ib];
    x_buf.data[ia] = a * cos_v - b * sin_v;
    x_buf.data[ib] = a * sin_v + b * cos_v;
}
