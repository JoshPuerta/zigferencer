// In-place RoPE on one head_dim vector at position pos. For i in [0, rope_dim/2)
// one lane rotates one pair by an angle built from freq_base, pos, i, and the
// per-pair frequency factor. Dims at or past rope_dim stay untouched.
//
//   theta = freq_base^(-2i / rope_dim)
//   angle = pos * theta / ff[i]
//   (x[a], x[b]) = (x[a] cos - x[b] sin, x[a] sin + x[b] cos)
//
// Pairing follows the rope type of the architecture (the vocabulary of llama.cpp):
//   style_norm = 1  adjacent pairs (x[2i], x[2i+1]), the llama family. The GGUF
//                   conversion permutes the Q and K weights for this layout.
//   style_norm = 0  half-split pairs (x[i], x[i+half]), the neox and qwen family.
// The wrong style scrambles attention geometry at every position.
//
//   binding 0  readwrite f32 x[]                 (rotated in place)
//   binding 1  readonly  f32 ff[rope_dim/2]      (freq divisors, all ones = classic)
//   push       uint pos, uint rope_dim, float freq_base, uint style_norm
//
// Each lane rotates one pair, so the dispatch is ceil((rope_dim/2) / 64)
// workgroups at local_size_x = 64. head_dim is 64 or 128 across the bench models,
// so one head is one or two workgroups. That small size makes per-head RoPE
// dispatch-overhead bound, which is why the `rope_multi` variant exists.
//
// GPU `pow`, `cos`, and `sin` round differently from the CPU intrinsics, so the
// result is not bit-exact. The Zig wrapper `Rope` declares `.relative = 5e-5`.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer FfBuf {
    float data[];
} ff_buf;

layout(push_constant) uniform Params {
    uint pos;
    uint rope_dim;
    float freq_base;
    uint style_norm;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint half_dim = params.rope_dim / 2u;
    if (i >= half_dim) return;

    float inv_dim = 1.0 / float(params.rope_dim);
    float exp_v = -2.0 * float(i) * inv_dim;
    float theta = pow(params.freq_base, exp_v);
    float angle = float(params.pos) * theta / ff_buf.data[i];
    float cos_v = cos(angle);
    float sin_v = sin(angle);
    uint ia = (params.style_norm == 1u) ? 2u * i : i;
    uint ib = (params.style_norm == 1u) ? 2u * i + 1u : i + half_dim;
    float a = x_buf.data[ia];
    float b = x_buf.data[ib];
    x_buf.data[ia] = a * cos_v - b * sin_v;
    x_buf.data[ib] = a * sin_v + b * cos_v;
}
