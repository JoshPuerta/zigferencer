// kv_commit_f16: k_out[i] = float16_t(k_src[i]) and v_out[i] = float16_t(v_src[i]) for i < n.
//
// What
//   The runner writes K and V to two contiguous f32 scratch buffers, then scatters them into the
//   cache with a copy list. This kernel narrows the scratch between those steps. It never sees
//   the cache layout, and the scatter stays a plain copy list of halved regions. The rejected form
//   converts at the scatter. Its (slot, position) table does not fit the 128-byte push-constant
//   guarantee, so it needs a row-descriptor buffer or one dispatch per row.
//
// Hardware
//   Lane i touches element i of all four buffers, so every load and every store coalesces across
//   the wave. 64 lanes are 2 wave32 waves, and the grid is (ceil(n / 64), 1, 1). One dispatch per
//   layer covers a whole commit whatever the row count, because the scratch is contiguous. K and
//   V share the dispatch because they share n and neither depends on the other. That halves the
//   dispatch count against a kernel per tensor.
//
// Numerics
//   Bit-exact: the kernel declares the SPIR-V `RoundingModeRTE` execution mode at width 16, so the
//   CPU commit and the GPU commit round the same way. The CPU commit narrows with F16C, which
//   rounds to nearest even. The declared mode asks the device for that same rule in place of the
//   driver default. The device conversion then rounds the same as the Zig `@floatCast`.
//   `tests/vulkan_kv_commit_f16_test.zig` gates the identity bit for bit.
//
// Bindings
//   0     readonly   f32  k_src[n]
//   1     readonly   f32  v_src[n]
//   2     writeonly  f16  k_out[n]
//   3     writeonly  f16  v_out[n]
//   push  uint n, the element count of one layer of K scratch, which equals the V count

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_spirv_intrinsics : require

spirv_execution_mode(extensions = ["SPV_KHR_float_controls"], capabilities = [4467], 4462, 16);

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer KSrcBuf {
    float data[];
} k_src_buf;

layout(std430, set = 0, binding = 1) readonly buffer VSrcBuf {
    float data[];
} v_src_buf;

layout(std430, set = 0, binding = 2) writeonly buffer KOutBuf {
    float16_t data[];
} k_out_buf;

layout(std430, set = 0, binding = 3) writeonly buffer VOutBuf {
    float16_t data[];
} v_out_buf;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    k_out_buf.data[i] = float16_t(k_src_buf.data[i]);
    v_out_buf.data[i] = float16_t(v_src_buf.data[i]);
}
