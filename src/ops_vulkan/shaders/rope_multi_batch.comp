// RoPE over every head of B token rows in a single dispatch. The rotation is the
// one in `rope.comp`, extended over a batch dimension. This variant exists so
// that the whole RoPE of a prefill chunk is one dispatch instead of B of them.
//
// The absolute position of row bi is start_pos + bi * pos_stride, so the push
// constant `pos_stride` switches the kernel between callers. It is 1 for prefill,
// where row bi is token start_pos + bi. It is 0 for lockstep decode, where every
// row shares start_pos. `row_base` offsets the buffer row a dispatch touches
// without moving the position math. A caller with arbitrary per-row positions,
// such as batched decode over independent serve sessions, therefore records one
// single-row dispatch per row: row_base = i, B = 1, start_pos = pos_i.
//
//   binding 0  readwrite f32 x[n_rows_total * n_heads * head_dim]
//   binding 1  readonly  f32 ff[rope_dim/2]
//   push       uint start_pos, head_dim, rope_dim, float freq_base,
//              uint n_heads, uint pos_stride, uint style_norm, uint row_base
//
// The dispatch grid is (ceil((rope_dim/2) / 64), n_heads, B). gl_WorkGroupID.y is
// the head and gl_WorkGroupID.z is the batch row.
//
// GPU `pow`, `cos`, and `sin` round differently from the CPU intrinsics, so the
// result is not bit-exact. The Zig wrapper `RopeMultiBatch` declares
// `.relative = 1e-5`.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer FfBuf {
    float data[];
} ff_buf;

layout(push_constant) uniform Params {
    uint start_pos;
    uint head_dim;
    uint rope_dim;
    float freq_base;
    uint n_heads;
    // 1 for prefill, where the position of row bi is start_pos + bi.
    // 0 for lockstep or one row per dispatch, where the position is start_pos.
    uint pos_stride;
    uint style_norm;
    // First buffer row this dispatch touches. Positions stay relative to bi.
    uint row_base;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint head = gl_WorkGroupID.y;
    uint bi = gl_WorkGroupID.z;
    uint half_dim = params.rope_dim / 2u;
    if (i >= half_dim) return;

    uint pos = params.start_pos + bi * params.pos_stride;
    uint base = ((params.row_base + bi) * params.n_heads + head) * params.head_dim;

    float inv_dim = 1.0 / float(params.rope_dim);
    float exp_v = -2.0 * float(i) * inv_dim;
    float theta = pow(params.freq_base, exp_v);
    float angle = float(pos) * theta / ff_buf.data[i];
    float cos_v = cos(angle);
    float sin_v = sin(angle);
    uint ia = (params.style_norm == 1u) ? base + 2u * i : base + i;
    uint ib = (params.style_norm == 1u) ? base + 2u * i + 1u : base + i + half_dim;
    float a = x_buf.data[ia];
    float b = x_buf.data[ib];
    x_buf.data[ia] = a * cos_v - b * sin_v;
    x_buf.data[ib] = a * sin_v + b * cos_v;
}
