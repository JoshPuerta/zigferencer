// rope_multi_batch: the rotation of `rope.comp` over every head of B token rows in one dispatch.
//
// What
//   This variant makes the whole RoPE of a prefill chunk one dispatch instead of B of them. A
//   caller with arbitrary per-row positions, such as batched decode over independent serve
//   sessions, records one single-row dispatch per row: row_base = i, B = 1, start_pos = pos_i.
//
// Math
//   Pair i of head `head` at row bi takes the rotation of `rope.comp` at an offset:
//
//     pos   = start_pos + bi * pos_stride
//     base  = ((row_base + bi) * n_heads + head) * head_dim
//     angle = pos * freq_base^(-2i / rope_dim) / ff[i]
//     ia    = base + a, ib = base + b, with a and b from the pairing of `rope.comp`
//     (x[ia], x[ib]) = (x[ia] cos - x[ib] sin, x[ia] sin + x[ib] cos)
//
// Schedule
//   grid       (ceil((rope_dim / 2) / 64), n_heads, B)
//   workgroup  64 lanes. Workgroup (g, head, bi) owns pair block g of one head of one row.
//   lane       Lane l owns pair i = g * 64 + l, which is gl_GlobalInvocationID.x.
//
//                 g = 0         g = 1
//               +-------------+---------------+-----+
//     head 0    | i = 0 .. 63 | i = 64 .. 127 | ... |  one slab of the grid per row bi
//               +-------------+---------------+-----+
//     head 1    | i = 0 .. 63 | i = 64 .. 127 | ... |
//               +-------------+---------------+-----+
//
// Hardware
//   Waves: 64 lanes are 2 wave32 waves. A lane past the last pair returns, and no barrier follows.
//
// Numerics
//   Tolerance: `RopeMultiBatch` declares `.relative = 1e-5`. The GPU `pow`, `cos`, and `sin` round
//   differently from the CPU intrinsics. The kernel has no reduction, so no summation order
//   applies.
//
// Bindings
//   0     readwrite  f32  x[n_rows_total * n_heads * head_dim]
//   1     readonly   f32  ff[rope_dim / 2]
//   push  uint start_pos, head_dim, rope_dim, float freq_base, uint n_heads, pos_stride,
//         style_norm, row_base
//   pos_stride is 1 for prefill, where row bi is token start_pos + bi. It is 0 for lockstep decode
//   and for one row per dispatch, where every row shares start_pos. row_base is the first buffer
//   row of this dispatch, and it does not move the position math.

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer FfBuf {
    float data[];
} ff_buf;

layout(push_constant) uniform Params {
    uint start_pos;
    uint head_dim;
    uint rope_dim;
    float freq_base;
    uint n_heads;
    uint pos_stride;  // 1 for prefill, 0 for lockstep decode or one row per dispatch
    uint style_norm;
    uint row_base;    // first buffer row of this dispatch
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint head = gl_WorkGroupID.y;
    uint bi = gl_WorkGroupID.z;
    uint half_dim = params.rope_dim / 2u;
    if (i >= half_dim) return;

    uint pos = params.start_pos + bi * params.pos_stride;
    uint base = ((params.row_base + bi) * params.n_heads + head) * params.head_dim;

    float inv_dim = 1.0 / float(params.rope_dim);
    float exp_v = -2.0 * float(i) * inv_dim;
    float theta = pow(params.freq_base, exp_v);
    float angle = float(pos) * theta / ff_buf.data[i];
    float cos_v = cos(angle);
    float sin_v = sin(angle);
    uint ia = (params.style_norm == 1u) ? base + 2u * i : base + i;
    uint ib = (params.style_norm == 1u) ? base + 2u * i + 1u : base + i + half_dim;
    float a = x_buf.data[ia];
    float b = x_buf.data[ib];
    x_buf.data[ia] = a * cos_v - b * sin_v;
    x_buf.data[ib] = a * sin_v + b * cos_v;
}
