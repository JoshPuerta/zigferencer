// Batched RMSNorm: the normalization of `rmsnorm.comp` run independently on each
// of the B rows of a (B, d) input. Batched prefill uses it to normalize many
// token positions in one dispatch, which is why this variant sits next to the
// single-row kernel.
//
//   y[b][i] = x[b][i] / sqrt(mean(x[b]^2) + eps) * w[i]
//
//   binding 0  readonly  f32 x[B * d]
//   binding 1  readonly  f32 w[d]        (one weight, shared by every row)
//   binding 2  writeonly f32 y[B * d]
//   push       uint d, float eps
//
// The dispatch is (B, 1, 1) workgroups and gl_WorkGroupID.x selects the row. Each
// workgroup reduces its own row in LDS at local_size_x = 256, exactly as the
// decode kernel does. Per-row independence makes the batch parallel with no
// cross-row sync, so prefill scales with the number of resident workgroups the
// WGPs hold.
//
// The tree-reduce sums in a different order than the sequential scalar sum of the
// CPU reference, so the result is not bit-exact. The lane partial carries
// `precise` so that `glslc -O` cannot fuse `my_sum += v * v` into an fma, which
// changes the rounding and widens the gap. The decode kernel `rmsnorm.comp`
// carries the same qualifier, so one row normalizes the same way through prefill
// and through decode.
//
// The Zig wrapper `RmsnormBatch` declares `.relative = 5e-5`.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer WBuf {
    float data[];
} w_buf;

layout(std430, set = 0, binding = 2) writeonly buffer YBuf {
    float data[];
} y_buf;

layout(push_constant) uniform Params {
    uint d;
    float eps;
} params;

shared float lds_sum[256];

// -- main -------------------------------------------------------------------
void main() {
    uint batch = gl_WorkGroupID.x;
    uint local = gl_LocalInvocationID.x;
    uint d = params.d;
    uint row_off = batch * d;

    // Pass 1: sum of squares across the row, strided by 256.
    // `precise` keeps the lane partial out of an fma.
    precise float my_sum = 0.0;
    for (uint i = local; i < d; i += 256u) {
        precise float v = x_buf.data[row_off + i];
        my_sum += v * v;
    }
    lds_sum[local] = my_sum;
    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1) {
        if (local < stride) lds_sum[local] += lds_sum[local + stride];
        barrier();
    }

    float mean_sq = lds_sum[0] / float(d);
    float inv_rms = 1.0 / sqrt(mean_sq + params.eps);

    for (uint i = local; i < d; i += 256u) {
        y_buf.data[row_off + i] = x_buf.data[row_off + i] * inv_rms * w_buf.data[i];
    }
}
