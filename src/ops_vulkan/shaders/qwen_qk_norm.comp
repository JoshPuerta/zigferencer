// qwen_qk_norm: the per-head RMSNorm of Qwen3.5 full-attention Q and K, with the gate split.
//
// What
//   The kernel fuses the norm with the de-interleave of the query|gate projection. The fusion is
//   why this variant exists: a separate de-interleave pass reads and writes the whole projection
//   again. It serves the `qkNorm` op of the Qwen full-attention layer in runtime/qwen_layer.zig.
//
// Math
//   For head h and head index d, with inbase = in_off + h * in_stride:
//
//     out_buf[h, d]  = v_d * inversesqrt(sum_i v_i^2 / head_dim + eps) * norm_w[d]
//     gate_buf[h, d] = in_buf[inbase + gate_off + d], only when write_gate is 1
//
//   v_i is in_buf[inbase + i]. A positive eps keeps the argument above zero on an all-zero head.
//
// Schedule
//   grid       (n_heads, 1, 1)
//   workgroup  256 lanes. Workgroup h owns head h.
//   lane       Lane d owns head index d. head_dim equals local_size_x, so no lane strides.
//
//     q, in_stride = 2 * D  | q_0 | gate_0 | q_1 | gate_1 | ...     gate_off = D
//     k, in_stride = D      | k_0 | k_1 | ...                       no gate
//
//     pass 1  stage  each lane copies its gate element if asked, then writes v * v to `sq`
//     pass 2  norm   each lane sums `sq` with i ascending, then writes its output element
//
// Memory
//   The array holds one square per lane. The driver limit is 32 KiB.
//
//     sq  [256] f32  1 KiB  squared elements of this head
//
// Hardware
//   Waves: 256 lanes are 8 wave32 waves, one lane per head index.
//   Pass 1: the lanes of a wave read adjacent elements of in_buf, so the loads coalesce.
//   Pass 2: every lane runs the same 256-term sum over LDS, redundant work chosen in place of a
//   tree reduce so that the order holds.
//
// Numerics
//   Hash gate: `QwenQkNorm` declares no tolerance. The token-hash gates cover this kernel. Every
//   lane re-sums the squared head with i ascending, so the summation order matches the CPU
//   rmsnorm. The result then stays as close to bit-exact as `inversesqrt` allows.
//
// Bindings
//   0     readonly   f32  in_buf[n_heads * in_stride]   q|gate interleaved, or k
//   1     readonly   f32  norm_w[head_dim]              q_norm or k_norm weight
//   2     writeonly  f32  out_buf[n_heads * head_dim]   normed q or k
//   3     writeonly  f32  gate_buf[n_heads * head_dim]  raw gate half, if write_gate is 1
//   push  uint head_dim, in_stride, gate_off, write_gate, float eps, uint in_off, out_off
//   head_dim must be 256. in_off and out_off are the element offsets of prefill token t, and
//   decode passes 0 for both.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly  buffer B0 { float in_buf[]; };
layout(std430, set = 0, binding = 1) readonly  buffer B1 { float norm_w[]; };
layout(std430, set = 0, binding = 2) writeonly buffer B2 { float out_buf[]; };
layout(std430, set = 0, binding = 3) writeonly buffer B3 { float gate_buf[]; };

layout(push_constant) uniform Params {
    uint  head_dim;
    uint  in_stride;   // per-head stride in `in_buf`: 2 * head_dim (q|gate) or head_dim (k)
    uint  gate_off;    // offset of the gate half within the pair (head_dim for q)
    uint  write_gate;  // 1 to also write gate_buf, 0 otherwise
    float eps;
    uint  in_off;      // batched-row base into `in_buf`, 0 in decode
    uint  out_off;     // batched-row base into `out_buf` and `gate_buf`, 0 in decode
} p;

shared float sq[256];

// -- main -------------------------------------------------------------------
void main() {
    uint h = gl_WorkGroupID.x;
    uint d = gl_LocalInvocationID.x;
    uint D = p.head_dim;
    uint inbase = p.in_off + h * p.in_stride;
    uint outbase = p.out_off + h * D;

    // Pass 1: copy the gate element if the caller asks, then stage the square in LDS.
    float v = in_buf[inbase + d];
    if (p.write_gate != 0u) {
        gate_buf[outbase + d] = in_buf[inbase + p.gate_off + d];
    }

    sq[d] = v * v;
    barrier();

    // Pass 2: sum the squares with `i` ascending, then write this output element.
    float ss = 0.0;
    for (uint i = 0u; i < D; i++) {
        ss += sq[i];
    }

    float inv = inversesqrt(ss / float(D) + p.eps);
    out_buf[outbase + d] = v * inv * norm_w[d];
}
