// Per-head RMSNorm of the Qwen3.5 full-attention Q and K, fused with the
// de-interleave of the query|gate projection. The fusion is why this variant
// exists: a separate de-interleave pass reads and writes the whole projection
// again. It mirrors fullMixer in `runtime/qwen_runner.zig`.
//
//   out[h][d] = in[h][d] / sqrt(mean(in[h]^2) + eps) * norm_w[d]
//
// One workgroup handles one head and each lane owns one head-dim index. head_dim
// is 256, exactly local_size_x, so the mapping is one lane per dimension with no
// striding. q is the first head_dim of each [q_h | gate_h] pair, so in_stride is
// 2*head_dim and the gate reads from gate_off. k is contiguous, so in_stride is
// head_dim and there is no gate.
//
//   binding 0  readonly  f32 in[n_heads * in_stride]      q|gate interleaved, or k
//   binding 1  readonly  f32 norm_w[head_dim]             q_norm / k_norm weight
//   binding 2  writeonly f32 out[n_heads * head_dim]      normed q (or k)
//   binding 3  writeonly f32 gate_out[n_heads * head_dim] raw gate half, if write_gate
//   push       uint head_dim, in_stride, gate_off, write_gate, float eps,
//              uint in_off, out_off    (in_off/out_off: prefill token t, else 0)
//
// Unlike the other LDS reductions here, every lane re-sums the squared head over
// shared memory in sequence rather than tree-reducing. That is redundant work,
// chosen so the summation order matches the CPU rmsnorm. The result then stays as
// close to bit-exact as `inversesqrt` allows.
//
// The Zig wrapper `QwenQkNorm` declares no tolerance. The token-hash gates cover
// this kernel.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly  buffer B0 { float in_buf[]; };
layout(std430, set = 0, binding = 1) readonly  buffer B1 { float norm_w[]; };
layout(std430, set = 0, binding = 2) writeonly buffer B2 { float out_buf[]; };
layout(std430, set = 0, binding = 3) writeonly buffer B3 { float gate_buf[]; };

layout(push_constant) uniform Params {
    uint  head_dim;
    uint  in_stride;   // per-head stride in `in`: 2*head_dim (q|gate) or head_dim (k)
    uint  gate_off;    // offset of the gate half within the pair (head_dim for q)
    uint  write_gate;  // 1 to also write gate_buf, 0 otherwise
    float eps;
    uint  in_off;      // batched-row base into `in`   (prefill token t; decode 0)
    uint  out_off;     // batched-row base into out/gate (prefill token t; decode 0)
} p;

shared float sq[256];

// -- main -------------------------------------------------------------------
void main() {
    uint h = gl_WorkGroupID.x;
    uint d = gl_LocalInvocationID.x;
    uint D = p.head_dim;
    uint inbase = p.in_off + h * p.in_stride;
    uint outbase = p.out_off + h * D;

    float v = in_buf[inbase + d];
    if (p.write_gate != 0u) gate_buf[outbase + d] = in_buf[inbase + p.gate_off + d];

    sq[d] = v * v;
    barrier();
    float ss = 0.0;
    for (uint i = 0u; i < D; i++) ss += sq[i];
    float inv = inversesqrt(ss / float(D) + p.eps);
    out_buf[outbase + d] = v * inv * norm_w[d];
}
