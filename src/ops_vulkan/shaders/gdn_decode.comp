// gdn_decode: the Gated DeltaNet step of one Qwen3.5 GDN layer, one workgroup per key head.
//
// What
//   The kernel runs a causal depthwise conv1d with SiLU, the L2 norm of q and k, the q scale, the
//   gated delta recurrence, and a gated RMSNorm. It mirrors `step` in ops/gdn.zig. Decoupled heads
//   are legal: n_v can be a multiple of n_k. The 9B runs n_k = 16 and n_v = 32, and the 2B runs
//   n_v = n_k. One dispatch serves one token of decode or a run of same-slot rows of a batch.
//
// Math
//   Channel c holds a ring of its K - 1 last inputs, with ring[0, c] the oldest:
//
//     y_c = silu(sum_{tap<K-1} conv_w[c * K + tap] ring[tap, c] + conv_w[c * K + K-1] x_c)
//
//   The ring then shifts by one, and x_c enters at ring[K-2, c]. For key head ki:
//
//     q_n = q * inversesqrt(q . q + eps) * inversesqrt(D)
//     k_n = k * inversesqrt(k . k + eps)
//
//   For each value head vh = ki + vk * n_k, with S the D x D state of vh:
//
//     g     = ssm_a[vh] * softplus(alpha[vh] + dt_bias[vh])
//     S'    = exp(g) * S
//     delta = sigmoid(beta_in[vh]) * (v - S'^T k_n)
//     S     = S' + k_n (x) delta             (x) is the outer product
//     o     = S^T q_n
//     out_j = o_j * inversesqrt(o . o / D + eps) * ssm_norm_j * silu(z_j)
//
//   `ssm_a` is already -exp(A_log), so g < 0 and the decay exp(g) stays below 1.
//
// Schedule
//   grid       (n_k, 1, 1)
//   workgroup  128 lanes. Workgroup ki owns key head ki and every vh with vh % n_k = ki.
//   lane       Lane j owns element j of q, k, and each v, and column j of each state.
//
//                  q channels     k channels             v channels
//                +--------------+----------------------+--------------------------+
//     qkv row    | n_k * D      | n_k * D              | n_v * D                  |
//                +--------------+----------------------+--------------------------+
//     lane j     | ki * D + j   | key_dim + ki * D + j | 2 * key_dim + vh * D + j |
//                +--------------+----------------------+--------------------------+
//
//   The channels of two workgroups are disjoint, so `conv_state` advances in place with no race.
//   Token t takes the state and the ring from token t - 1 through global memory, so the token
//   loop equals n_tokens decode dispatches. Only the batched rows shift, by row0 + t. Each runs:
//
//     pass 1  conv   each lane convolves its q, k, and v channels, then stages q and k in LDS
//     pass 2  norm   each lane sums q . q and k . k over LDS, then rewrites its q and k elements
//     pass 3  delta  for each value head, the recurrence, then the gated norm through `osh`
//
// Memory
//   The arrays hold 128 elements, the head width, and take 1536 B. The driver limit is 32 KiB.
//
//     qsh, ksh  [128] f32 each  512 B each  q and k, then q_n and k_n
//     osh       [128] f32       512 B       readout row of one value head
//
// Hardware
//   Waves: 128 lanes are 4 wave32 waves, one lane per head index. A barrier waits for all four.
//   Registers: each lane holds `vconv`, MAX_V_PER_K = 8 floats, from pass 1 into pass 3.
//   Passes 1 to 3: the barriers of a token stay on chip at low cost. One dispatch per run removes
//   the n_tokens - 1 host pipeline barriers and dispatches per layer.
//   Pass 3: at one i, the lanes of a wave read adjacent elements of state row i, so the loads
//   coalesce.
//
// Numerics
//   Tolerance: `GdnDecode` declares `.relative = 1e-4`. The GPU `exp`, sigmoid, silu, and
//   `inversesqrt` differ from the CPU intrinsics. The cross-lane reductions are redundant
//   sequential sums over LDS, i ascending, and they hold the CPU summation order.
//
// Bindings
//   0     readonly   f32  qkv[rows * convDim]          q | k | v of each batched row
//   1     readonly   f32  z[rows * value_dim]          output-gate projection
//   2     readonly   f32  alpha[rows * n_v]            decay projection
//   3     readonly   f32  beta_in[rows * n_v]          delta-strength projection
//   4     readonly   f32  conv_w[K * convDim]          depthwise conv weights, [c * K + tap]
//   5     readonly   f32  ssm_a[n_v]                   already -exp(A_log), no batch row
//   6     readonly   f32  dt_bias[n_v]                 no batch row
//   7     readonly   f32  ssm_norm[D]                  gated-RMSNorm weight
//   8     readwrite  f32  state[n_v * D * D]           per slot, [vh * D * D + i * D + j]
//   9     readwrite  f32  conv_state[(K-1) * convDim]  per slot ring, [t * convDim + c]
//   10    writeonly  f32  o_out[rows * value_dim]      readout, before `ssm_out`
//   push  uint D, K, n_k, n_v, float eps, uint n_tokens, row0, state_off, conv_off
//   key_dim = n_k * D, value_dim = n_v * D, convDim = 2 * key_dim + value_dim, and v_per_k =
//   n_v / n_k, at most 8. D must be 128. n_tokens is 1 for decode and the run length for a batch.
//   rows reaches row0 + n_tokens. state_off and conv_off are element offsets of the slot region.
//   row0, state_off, and conv_off at zero address the first slot, the single-slot case.

#version 450

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0)  readonly  buffer B0  { float qkv[]; };
layout(std430, set = 0, binding = 1)  readonly  buffer B1  { float z[]; };
layout(std430, set = 0, binding = 2)  readonly  buffer B2  { float alpha[]; };
layout(std430, set = 0, binding = 3)  readonly  buffer B3  { float beta_in[]; };
layout(std430, set = 0, binding = 4)  readonly  buffer B4  { float conv_w[]; };
layout(std430, set = 0, binding = 5)  readonly  buffer B5  { float ssm_a[]; };
layout(std430, set = 0, binding = 6)  readonly  buffer B6  { float dt_bias[]; };
layout(std430, set = 0, binding = 7)  readonly  buffer B7  { float ssm_norm[]; };
layout(std430, set = 0, binding = 8)            buffer B8  { float state[]; };
layout(std430, set = 0, binding = 9)            buffer B9  { float conv_state[]; };
layout(std430, set = 0, binding = 10) writeonly buffer B10 { float o_out[]; };

layout(push_constant) uniform Params {
    uint  D;
    uint  K;
    uint  n_k;
    uint  n_v;
    float eps;
    uint  n_tokens;   // tokens of this dispatch
    uint  row0;       // first batched row of this run
    uint  state_off;  // element offset of the slot region in `state`
    uint  conv_off;   // element offset of the slot region in `conv_state`
} p;

const uint MAX_V_PER_K = 8u;

shared float qsh[128];
shared float ksh[128];
shared float osh[128];

// -- helpers ----------------------------------------------------------------
float silu(float x) { return x / (1.0 + exp(-x)); }
float sigmoidf(float x) { return 1.0 / (1.0 + exp(-x)); }
float softplusf(float x) { return (x > 20.0) ? x : log(1.0 + exp(x)); }

// Causal conv of K taps and SiLU for channel c at batched row `qkv_off`. It advances the ring of
// channel c in the slot region at `p.conv_off`, and the ring carries across the tokens of the run.
float conv_silu(uint c, uint qkv_off, uint K, uint convDim) {
    float xin = qkv[qkv_off + c];
    float acc = 0.0;
    for (uint t = 0u; t + 1u < K; t++) {
        acc += conv_w[c * K + t] * conv_state[p.conv_off + t * convDim + c];
    }

    acc += conv_w[c * K + (K - 1u)] * xin;
    for (uint t = 0u; t + 2u < K; t++) {
        conv_state[p.conv_off + t * convDim + c] = conv_state[p.conv_off + (t + 1u) * convDim + c];
    }

    conv_state[p.conv_off + (K - 2u) * convDim + c] = xin;
    return silu(acc);
}

// -- main -------------------------------------------------------------------
void main() {
    uint ki = gl_WorkGroupID.x;       // key head
    uint j = gl_LocalInvocationID.x;  // value-dim lane 0..D-1, with D == local_size_x
    uint D = p.D;
    uint K = p.K;
    uint key_dim = p.n_k * D;
    uint value_dim = p.n_v * D;
    uint convDim = 2u * key_dim + value_dim;
    uint v_per_k = p.n_v / p.n_k;
    float eps = p.eps;

    for (uint t = 0u; t < p.n_tokens; t++) {
        uint qkv_off = (p.row0 + t) * convDim;
        uint v_off   = (p.row0 + t) * value_dim;
        uint ab_off  = (p.row0 + t) * p.n_v;

        // Pass 1: conv and SiLU of the q and k of this key head and the v of its value heads.
        float qv = conv_silu(ki * D + j, qkv_off, K, convDim);
        float kv = conv_silu(key_dim + ki * D + j, qkv_off, K, convDim);
        float vconv[MAX_V_PER_K];
        for (uint vk = 0u; vk < v_per_k; vk++) {
            uint vh = ki + vk * p.n_k;
            vconv[vk] = conv_silu(2u * key_dim + vh * D + j, qkv_off, K, convDim);
        }

        qsh[j] = qv;
        ksh[j] = kv;
        barrier();

        // Pass 2: L2-norm q and k over the key head, and scale q by 1/sqrt(D) once per key head.
        float ssq = 0.0;
        float ssk = 0.0;
        for (uint i = 0u; i < D; i++) {
            ssq += qsh[i] * qsh[i];
            ssk += ksh[i] * ksh[i];
        }

        float qn = qsh[j] * inversesqrt(ssq + eps) * inversesqrt(float(D));
        float kn = ksh[j] * inversesqrt(ssk + eps);
        barrier();  // every lane has read `qsh` and `ksh` before any lane rewrites them

        qsh[j] = qn;
        ksh[j] = kn;
        barrier();

        // Pass 3: the recurrence and the gated norm of each value head of this key head.
        for (uint vk = 0u; vk < v_per_k; vk++) {
            uint vh = ki + vk * p.n_k;
            // `ssm_a` and `dt_bias` are per-layer weights and carry no batch row.
            // `alpha` and `beta_in` are per-token projections at offset `ab_off`.
            float g = ssm_a[vh] * softplusf(alpha[ab_off + vh] + dt_bias[vh]);
            float decay = exp(g);
            float beta = sigmoidf(beta_in[ab_off + vh]);
            uint sbase = p.state_off + vh * D * D;

            float kvmem = 0.0;
            for (uint i = 0u; i < D; i++) {
                float sij = state[sbase + i * D + j] * decay;
                state[sbase + i * D + j] = sij;
                kvmem += sij * ksh[i];
            }

            float delta = (vconv[vk] - kvmem) * beta;
            float oj = 0.0;
            for (uint i = 0u; i < D; i++) {
                float sij = state[sbase + i * D + j] + ksh[i] * delta;
                state[sbase + i * D + j] = sij;
                oj += sij * qsh[i];
            }

            osh[j] = oj;
            barrier();

            float sso = 0.0;
            for (uint i = 0u; i < D; i++) {
                sso += osh[i] * osh[i];
            }

            float invo = inversesqrt(sso / float(D) + eps);
            o_out[v_off + vh * D + j] = oj * invo * ssm_norm[j] * silu(z[v_off + vh * D + j]);
            barrier();  // every lane is done with `osh` before the next head or token reuses it
        }
    }
}
