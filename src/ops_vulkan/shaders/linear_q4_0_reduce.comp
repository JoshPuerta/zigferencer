// linear_q4_0_reduce: the Q4_0 decode matvec, (1, K) f32 input times (N, K) weight to (N) f32.
//
// What
//   This is the Q4_0 sibling of `linear_q8_0_reduce.comp`, with the same structure. Only the
//   dequant changes, from 8-bit bytes to 4-bit nibbles, so the quants buffer is half the size.
//   That halving is the whole point. Decode is memory-bandwidth-bound, because B = 1 streams the
//   whole weight once per token. A bandwidth-bound matvec therefore runs faster, and this kernel
//   exists to measure by how much.
//
// Math
//   Here input[blk] is the 32 elements at blk * 32, and blk runs over the k / 32 blocks:
//
//     partial[L] = sum_{blk % 32 = L} input[blk] . dequant(weight[j][blk])
//     out[j]     = sum_{L in 0..31} partial[L]
//     dequant(w) = (nibble - 8) * scale, nibble in [0, 15]
//
//   The ggml Q4_0 block packs each 32-weight block into 16 bytes, which is 4 uint32 words. Weight
//   i (i < 16) is the low nibble of byte i, and weight i + 16 is the high nibble of byte i.
//   Each block belongs to exactly one lane, so the partials cover the output once.
//
// Schedule
//   grid       (min(n, GRID_X), ceil(n / GRID_X), 1)
//   workgroup  32 lanes. One workgroup owns one output j = gl_WorkGroupID.y * GRID_X +
//              gl_WorkGroupID.x, so a vocabulary past one axis of the grid folds onto y.
//   lane       Lane L owns the weight blocks L, L + 32, L + 64, ... of output j.
//
//     lane L sums blocks L, L+32, L+64, ...     (strided, so a wave reads one run)
//           \____________ 32 lane partials ____________/
//                                  |
//                        LDS + barrier, lane 0 sums  ->  out[j]
//
//     pass 1  sum     each lane sums its strided blocks and stores the partial to LDS
//     pass 2  reduce  lane 0 sums the 32 partials and writes out[j]
//
// Memory
//   LDS at 32 lanes. The driver limit is 32 KiB.
//
//     lds_partials  [32] f32  128 B  one partial per lane
//
// Hardware
//   Waves: local_size_x = 32 is one wave32 wave, so a barrier waits for no other wave.
//   Pass 1: Q4_0 reads about half the bytes of Q8_0: 16 packed bytes against 32 per 32-weight
//   block, plus the same 2-byte scale. Adjacent lanes read adjacent weight blocks.
//   Tails: the workgroups at the last y of the grid can lie past n. Such a workgroup still
//   stores a zero partial and reaches the barrier, so every lane leaves through the same barrier.
//
// Numerics
//   Tolerance: `LinearQ40Reduce` declares `.relative = 2e-4`. The lane partials accumulate in lane
//   order and lane 0 then sums them, so the result is not bit-exact. No `precise` marks the inner
//   chain, so the device compiler can fuse a multiply and an add into an FMA. A lane adds blk and
//   i ascending, with element i before element i + 16, and lane 0 adds L ascending.
//
// Bindings
//   0     readonly   f32   input[k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 8) * n]
//   3     writeonly  f32   out[n]
//   push  uint k, uint n
//
// Defines
//   GRID_X  workgroups on the x axis, from `limits.reduce_grid_x`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// -- configuration ----------------------------------------------------------
// The shader table gives the same value to the host dispatch that sizes the grid.
#ifndef GRID_X
#error "GRID_X must come from the build (the vulkan_shaders table)"
#endif

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint k;
    uint n;
} params;

shared float lds_partials[32];

// -- main -------------------------------------------------------------------
void main() {
    uint j = gl_WorkGroupID.y * GRID_X + gl_WorkGroupID.x;
    uint local = gl_LocalInvocationID.x;
    if (j >= params.n) {
        lds_partials[local] = 0.0;
        barrier();

        return;
    }

    uint blocks_per_output = params.k / 32u;
    uint words_per_output = params.k / 8u;  // 4 words (16 bytes) per block

    // Pass 1: sum the strided blocks of this lane.
    float partial = 0.0;
    for (uint blk = local; blk < blocks_per_output; blk += 32u) {
        float scale = float(scales_buf.data[j * blocks_per_output + blk]);
        uint word_base = j * words_per_output + blk * 4u;

        for (uint i = 0u; i < 16u; ++i) {
            uint word = quants_buf.data[word_base + (i >> 2)];
            uint shift = (i & 3u) * 8u;
            int lo = int((word >> shift) & 0xFu) - 8;
            int hi = int((word >> (shift + 4u)) & 0xFu) - 8;
            partial += input_buf.data[blk * 32u + i] * scale * float(lo);
            partial += input_buf.data[blk * 32u + 16u + i] * scale * float(hi);
        }
    }

    lds_partials[local] = partial;
    barrier();

    // Pass 2: lane 0 sums the partials in lane order.
    if (local == 0u) {
        precise float sum = 0.0;
        for (uint i = 0u; i < 32u; ++i) {
            sum += lds_partials[i];
        }

        out_buf.data[j] = sum;
    }
}
