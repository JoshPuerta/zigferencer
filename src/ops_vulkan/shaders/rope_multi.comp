// rope_multi: the rotation of `rope.comp` over every head of one token in one dispatch.
//
// What
//   This variant collapses the per-head dispatch loop, tens of dispatches per layer, into one
//   dispatch. RoPE does little arithmetic, so dispatch overhead dominates its GPU cost, and fusing
//   the heads amortizes that overhead. `rope.comp` holds the style_norm pairing and the `ff`
//   frequency divisors.
//
// Math
//   Pair i of head `head` takes the rotation of `rope.comp` at an offset:
//
//     base  = head * head_dim
//     angle = pos * freq_base^(-2i / rope_dim) / ff[i]
//     ia    = base + a, ib = base + b, with a and b from the pairing of `rope.comp`
//     (x[ia], x[ib]) = (x[ia] cos - x[ib] sin, x[ia] sin + x[ib] cos)
//
// Schedule
//   grid       (ceil((rope_dim / 2) / 64), n_heads, 1)
//   workgroup  64 lanes. Workgroup (g, head) owns pair block g of one head.
//   lane       Lane l owns pair i = g * 64 + l, which is gl_GlobalInvocationID.x.
//
//                 g = 0         g = 1
//               +-------------+---------------+-----+
//     head 0    | i = 0 .. 63 | i = 64 .. 127 | ... |
//               +-------------+---------------+-----+
//     head 1    | i = 0 .. 63 | i = 64 .. 127 | ... |
//               +-------------+---------------+-----+
//
// Hardware
//   Waves: 64 lanes are 2 wave32 waves. A lane past the last pair returns, and no barrier follows.
//
// Numerics
//   Tolerance: `RopeMulti` declares `.relative = 1e-5`. The GPU `pow`, `cos`, and `sin` round
//   differently from the CPU intrinsics. The kernel has no reduction, so no summation order
//   applies.
//
// Bindings
//   0     readwrite  f32  x[n_heads * head_dim]
//   1     readonly   f32  ff[rope_dim / 2]
//   push  uint pos, head_dim, rope_dim, float freq_base, uint style_norm

#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) readonly buffer FfBuf {
    float data[];
} ff_buf;

layout(push_constant) uniform Params {
    uint pos;
    uint head_dim;
    uint rope_dim;
    float freq_base;
    uint style_norm;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint head = gl_WorkGroupID.y;
    uint half_dim = params.rope_dim / 2u;
    if (i >= half_dim) return;

    uint base = head * params.head_dim;
    float inv_dim = 1.0 / float(params.rope_dim);
    float exp_v = -2.0 * float(i) * inv_dim;
    float theta = pow(params.freq_base, exp_v);
    float angle = float(params.pos) * theta / ff_buf.data[i];
    float cos_v = cos(angle);
    float sin_v = sin(angle);
    uint ia = (params.style_norm == 1u) ? base + 2u * i : base + i;
    uint ib = (params.style_norm == 1u) ? base + 2u * i + 1u : base + i + half_dim;
    float a = x_buf.data[ia];
    float b = x_buf.data[ib];
    x_buf.data[ia] = a * cos_v - b * sin_v;
    x_buf.data[ib] = a * sin_v + b * cos_v;
}
