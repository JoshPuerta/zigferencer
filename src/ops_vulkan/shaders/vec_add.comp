// Elementwise add over a 1D f32 buffer: out[i] = a[i] + b[i]. It is the
// proof-of-life kernel of the Vulkan backend. One dispatch exercises the whole
// compute stack: instance, device, queue, descriptor set, pipeline, and command
// buffer. Every other kernel builds on those primitives, so a failure here
// points at the stack and not at the math.
//
// Lane i owns element i. local_size_x = 256 gives 8 RDNA2 wave32 waves per
// workgroup, and the dispatch is ceil(n / 256) workgroups. Eight waves keep a WGP
// busy and hide memory latency without pinning so many registers that occupancy
// drops. The other per-element kernels (residual_add, swiglu, sigmoid_gate) share
// that trade-off.
//
//   binding 0  readonly  f32 a[n]
//   binding 1  readonly  f32 b[n]
//   binding 2  writeonly f32 out[n]
//   push       uint n    (element count, bounds the loop)
//
// Bit-exact against the CPU reference: the kernel does one IEEE-754 add per
// element, so there is no reduction order and no accumulator to drift.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer BufferA {
    float data[];
} a;

layout(std430, set = 0, binding = 1) readonly buffer BufferB {
    float data[];
} b;

layout(std430, set = 0, binding = 2) writeonly buffer BufferOut {
    float data[];
} o;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;
    o.data[i] = a.data[i] + b.data[i];
}
