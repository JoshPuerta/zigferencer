// vec_add: out[i] = a[i] + b[i], the proof-of-life kernel of the Vulkan backend.
//
// What
//   One dispatch exercises the whole compute stack: instance, device, queue, descriptor set,
//   pipeline, and command buffer. Every other kernel builds on those primitives, so a failure
//   here points at the stack and not at the math.
//
// Hardware
//   Lane i owns element i. 256 lanes are 8 wave32 waves, and the grid is (ceil(n / 256), 1, 1).
//   Eight waves keep a WGP busy and hide memory latency without pinning so many registers that
//   occupancy drops. `residual_add`, `swiglu`, and `sigmoid_gate` share that trade-off.
//
// Numerics
//   Bit-exact: the kernel does one IEEE-754 add per element, so it has no reduction order and no
//   accumulator to drift.
//
// Bindings
//   0     readonly   f32  a[n]
//   1     readonly   f32  b[n]
//   2     writeonly  f32  out[n]
//   push  uint n, the element count

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer BufferA {
    float data[];
} a;

layout(std430, set = 0, binding = 1) readonly buffer BufferB {
    float data[];
} b;

layout(std430, set = 0, binding = 2) writeonly buffer BufferOut {
    float data[];
} o;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    o.data[i] = a.data[i] + b.data[i];
}
