// linear_q8_0_gemm: the wide prefill matmul, register-blocked and staged through LDS.
//
// What
//   This is the prefill matmul for a chunk of many rows. It has the storage bindings and the
//   push constants of `linear_q8_0_batch.comp`, so the runner swaps one for the other at
//   `recordInto`. The two kernels differ in their mapping. This one is built for occupancy.
//
// Math
//   C[B, N] = A[B, K] @ dequant(W[N, K])^T, with A and C in f32:
//
//     C[b][n] = sum_k A[b][k] * scale[n][k / 32] * quant[n][k]
//
//   W is Q8_0: one f16 scale per 32-element block, and i8 quants packed 4 per uint, row-major
//   [N][K]. K is a multiple of 32. The kernel steps K in BK = 32, one Q8_0 block, so one k-tile
//   holds exactly one scale per output column.
//
// Schedule
//   grid       (ceil(N / BN), ceil(B / BM), 1)
//   workgroup  256 lanes, 16 x 16. One BM x BN output tile, BM = 64 rows by BN = 64 columns.
//   lane       Lane (tx, ty) owns one TM x TN = 4 x 4 micro-tile of the output.
//
//                     BN = 64 output cols
//                  +--------------------------+
//                  | (0,0) (1,0) ...   (15,0) |   lane (tx, ty) writes output
//        BM = 64   | (0,1)                    |     rows  ty*4 .. ty*4+3
//        batch     |   ...    4x4 each        |     cols  tx*4 .. tx*4+3
//        rows      | (0,15)            (15,15)|
//                  +--------------------------+
//
//   Each k-tile kt of K / BK runs passes 1 to 3, and pass 4 runs once at the end:
//
//     pass 1  stage A   each lane loads 8 elements of the A tile into As, transposed
//     pass 2  stage W   each lane loads and dequantizes 8 elements of the W tile into Bs
//     pass 3  multiply  each lane adds its micro-tile outer products over the k-tile
//     pass 4  write     each lane stores its micro-tile, skipping the tails
//
// Memory
//   LDS at BM = BN = 64 and BK = 32. The driver limit is 32 KiB.
//
//     As  [BK][BM] f32   8 KiB   A tile, transposed, so the inner loop reads contiguous rows
//     Bs  [BK][BN] f32   8 KiB   the dequantized W tile
//
//   Each W tile loads once per workgroup, and every one of the BM rows reuses it. A b-token
//   prefill streams the weights ceil(b / BM) times: 2 at b = 128, against 8 for the batch kernel
//   at B_TILE = 16.
//
// Hardware
//   Waves: 256 lanes are 8 wave32 waves.
//   Occupancy: the batch kernel runs one wave per workgroup, so its per-lane registers cap the
//   resident waves. It runs at 13% to 21% of FP32 peak, and its bandwidth falls as B_TILE grows.
//   Here workgroup reuse and per-lane registers are separate: the tile grows in LDS, and a lane
//   holds only a micro-tile. Register pressure stays about constant while the reuse grows.
//   Passes 1 and 2: the kernel expects a wave to hold 32 lanes of adjacent tid. Such a wave loads
//   adjacent elements of one row, so the loads coalesce.
//   Tails: every lane reaches each barrier, because a row or column past the tail zero-fills.
//
// Numerics
//   Tolerance: `LinearQ80Gemm` declares `.relative = 2e-4`. The micro-tile accumulation reorders
//   the reduction, and no `precise` marks it, so the device compiler can fuse a multiply and an
//   add into an FMA.
//
// Bindings
//   0     readonly   f32   input[B * k]
//   1     readonly   f16   scales[(k / 32) * n]
//   2     readonly   uint  quants_packed[(k / 4) * n]
//   3     writeonly  f32   out[B * n]
//   push  uint b, uint k, uint n
//
// Defines
//   BM  batch rows of one tile, from `limits.gemm_m_tile`
//   BN  output columns of one tile, from `limits.gemm_n_tile`

#version 450
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// -- configuration ----------------------------------------------------------
// The host grid arithmetic reads the same two values, BM and BN, from the shader table.
#if !defined(BM) || !defined(BN)
#error "BM and BN must come from the build (the vulkan_shaders table)"
#endif
#define BK 32u
#define TM 4u
#define TN 4u

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer InputBuf {
    float data[];
} input_buf;

layout(std430, set = 0, binding = 1) readonly buffer ScalesBuf {
    float16_t data[];
} scales_buf;

layout(std430, set = 0, binding = 2) readonly buffer QuantsBuf {
    uint data[];
} quants_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint b;
    uint k;
    uint n;
} params;

shared float As[BK][BM];  // As[kk][row]
shared float Bs[BK][BN];  // Bs[kk][col]

// -- main -------------------------------------------------------------------
void main() {
    uint tx = gl_LocalInvocationID.x;  // 0..15, the column group
    uint ty = gl_LocalInvocationID.y;  // 0..15, the row group
    uint tid = ty * 16u + tx;          // 0..255

    uint bm_base = gl_WorkGroupID.y * BM;  // batch-row tile base
    uint bn_base = gl_WorkGroupID.x * BN;  // output-col tile base

    uint K = params.k;
    uint N = params.n;
    uint B = params.b;
    uint blocks_per_row = K / BK;  // scales: blocks per weight row
    uint words_per_row = K / 4u;   // quants: u32 words per weight row, 4 i8 each

    float acc[TM][TN];
    for (uint m = 0u; m < TM; m++) {
        for (uint nn = 0u; nn < TN; nn++) {
            acc[m][nn] = 0.0;
        }
    }

    uint num_k_tiles = K / BK;
    for (uint kt = 0u; kt < num_k_tiles; kt++) {
        uint k_base = kt * BK;

        // Pass 1: stage the A tile into As, 2048 elements over 256 lanes, 8 each.
        for (uint s = 0u; s < (BM * BK) / 256u; s++) {
            uint idx = tid + s * 256u;  // 0..2047
            uint r = idx / BK;          // 0..63, the row in the tile
            uint c = idx % BK;          // 0..31, the k in the tile
            uint brow = bm_base + r;
            float v = 0.0;
            if (brow < B) {
                v = input_buf.data[brow * K + k_base + c];
            }

            As[c][r] = v;
        }

        // Pass 2: stage and dequantize the W tile into Bs, one scale per column.
        for (uint s = 0u; s < (BN * BK) / 256u; s++) {
            uint idx = tid + s * 256u;  // 0..2047
            uint c = idx / BK;          // 0..63, the col in the tile
            uint kk = idx % BK;         // 0..31, the k in the tile
            uint col = bn_base + c;
            float v = 0.0;
            if (col < N) {
                float scale = float(scales_buf.data[col * blocks_per_row + kt]);
                uint word = quants_buf.data[col * words_per_row + (k_base >> 2) + (kk >> 2)];
                int qi = bitfieldExtract(int(word), int((kk & 3u) * 8u), 8);
                v = scale * float(qi);
            }

            Bs[kk][c] = v;
        }
        barrier();

        // Pass 3: add the micro-tile outer products of this k-tile.
        for (uint kk = 0u; kk < BK; kk++) {
            float a[TM];
            float bcol[TN];
            for (uint m = 0u; m < TM; m++) {
                a[m] = As[kk][ty * TM + m];
            }

            for (uint nn = 0u; nn < TN; nn++) {
                bcol[nn] = Bs[kk][tx * TN + nn];
            }

            for (uint m = 0u; m < TM; m++) {
                for (uint nn = 0u; nn < TN; nn++) {
                    acc[m][nn] += a[m] * bcol[nn];
                }
            }
        }
        barrier();
    }

    // Pass 4: write the micro-tile. A row or column past the tail has no output.
    for (uint m = 0u; m < TM; m++) {
        uint row = bm_base + ty * TM + m;
        if (row >= B) continue;

        for (uint nn = 0u; nn < TN; nn++) {
            uint col = bn_base + tx * TN + nn;
            if (col >= N) continue;

            out_buf.data[row * N + col] = acc[m][nn];
        }
    }
}
