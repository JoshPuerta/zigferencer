// attention: fused scaled-dot-product attention for decode, one query head per workgroup.
//
// What
//   The kernel runs the scores, the softmax, and the V-weighted sum of one decode row, for a row
//   of at most ATTN_SPLIT positions. It holds every score of the row in LDS at once. A deeper row
//   takes `attention_split.comp` and `attention_merge.comp`, which split the walk across
//   workgroups and merge the partials in a fixed order.
//
// Math
//   Head h walks the cached positions t in [0, t_len), with scale = 1 / sqrt(head_dim):
//
//     s_t       = (q[h] . k[t, kv_h]) * scale
//     m         = max_t s_t                      `vec_max`
//     e_t       = exp(s_t - m)
//     L         = sum_t e_t                      `vec_sum`
//     p_t       = e_t / L                        the softmax of s
//     out[h, d] = sum_t p_t * v[t, kv_h, d]
//
//   The shift by m makes the largest e_t 1, so L is at least 1 and the division meets no zero.
//
// Schedule
//   grid       (n_heads, 1, 1)
//   workgroup  64 lanes. Workgroup h serves query head h.
//   lane       Each pass assigns the lanes in its own way, as the pass table shows.
//
//     group_size = n_heads / n_kv_heads    query heads of one KV head
//     kv_h       = h / group_size          grouped-query attention: workgroups share a KV head
//
//                 d = 0     d = 1           d = 63    d = 64
//               +---------+---------+-----+---------+---------+
//     t = 0     | lane 0 --------------------------------->   |   pass 1: lane l walks the rows
//     t = 1     | lane 1 --------------------------------->   |   t = l + 64 i
//       ...     |                                             |
//     t = 64    | lane 0 --------------------------------->   |
//               +---------+---------+-----+---------+---------+
//                 lane 0    lane 1          lane 63   lane 0      pass 5: lane l walks the columns
//                                                                 d = l + 64 i
//
//   Passes 2 and 3 fold 64 lane partials to 1 with an LDS tree, one barrier per step. In step
//   k = 32, 16, 8, 4, 2, 1, each lane l < k folds slot l + k into slot l.
//
//     pass 1  scores     lane l computes s_t at positions l + 64 i
//     pass 2  max        lane l folds positions l + 64 i into slot l, then the tree runs
//     pass 3  sum        lane l turns s_t into e_t and folds it into slot l, then the tree runs
//     pass 4  normalize  lane l turns e_t into p_t at positions l + 64 i
//     pass 5  V sums     lane l owns elements l + 64 i and walks every position
//
// Memory
//   LDS at ATTN_SPLIT = 256. The driver limit is 32 KiB.
//
//     scores      [ATTN_SPLIT] f32   1 KiB   one score per position, [t]
//     reduce_lds  [64] f32           256 B   one tree slot per lane, [l]
//
//   `scores` lives in LDS because each lane of pass 5 reads every position. `reduce_lds` lives
//   in LDS because a tree needs a scratchpad that every lane reads. `scores` cannot grow with the
//   context, because LDS per workgroup divides occupancy and the driver caps it.
//
// Hardware
//   Waves: 64 lanes are two wave32 waves. Two resident waves hide global memory latency behind
//   compute, and that covers the K and V fetches. One head per workgroup keeps the working set
//   hot. Every lane reads the same q[h] and walks the rows of one KV head, and those rows stay in
//   cache for the whole reduction of the head.
//   Registers: head_dim has no bound here. The kernel reads q and k per element from global memory
//   and holds no per-lane register vector, and pass 5 strides d by the workgroup size. So
//   head_dim 256, the Qwen3.5 full attention, runs unchanged, and `gpu-selftest attn` checks it
//   at GQA 8 to 2.
//   Pass 1: adjacent lanes read rows n_kv_heads * head_dim elements apart, so the loads do not
//   coalesce across the wave. Each lane walks its own row in order, so it consumes every line it
//   fetches. The q row is a broadcast that the cache serves to all lanes.
//   Passes 2 to 4: LDS only, plus the exp of pass 3.
//   Pass 5: adjacent lanes touch adjacent addresses of one V row, so those reads coalesce.
//
// Numerics
//   Tolerance: `Attention` declares `.relative = 1e-3`. The LDS sum tree reorders the softmax sum
//   against the CPU reference, and the GPU exp rounds differently. `gpu-selftest attn` prints the
//   measured error of each shape. The bench keeps a floor on a near-zero denominator, because
//   outputs that cancel to near zero inflate rel_err without it. The tests gate the SmolLM2 shape
//   at 128 positions and the Qwen3.5 shape up to ATTN_SPLIT positions. `precise` chains run in
//   ascending d for a score and ascending t for a V sum, and each tree folds fixed slot pairs, so
//   a run repeats its bytes.
//
// Bindings
//   0     readonly   f32      q[n_heads * head_dim]
//   1     readonly   KV_ELEM  k_cache[t_len * n_kv_heads * head_dim]
//   2     readonly   KV_ELEM  v_cache[t_len * n_kv_heads * head_dim]
//   3     writeonly  f32      out[n_heads * head_dim]
//   push  uint n_heads, n_kv_heads, head_dim, t_len
//
//   Element d of K at (t, kv_h) sits at t * n_kv_heads * head_dim + kv_h * head_dim + d, and V
//   matches. The host asserts 1 <= t_len <= ATTN_SPLIT and that n_kv_heads divides n_heads. The
//   kernel has no guard on t_len, so a longer row writes past `scores`.
//
// Defines
//   ATTN_SPLIT  LDS score row, from `limits.attn_split_len`. It is the deepest resident row.
//   KV_F16      set for the f16 blob. The rows hold packed halves, the bytes that the commit wrote.
//               Only the K and V storage type moves, and the loads widen to float at the read.
//               `scores` stays `shared float`, the accumulators stay `precise float`, and the push
//               constants keep their layout. The element indexing stays, as the element count of a
//               row does not depend on the element width. `build.zig` compiles this one source
//               twice, so the two variants cannot drift apart.

#version 450

// -- configuration ----------------------------------------------------------
#ifdef KV_F16
// Word w holds elements 2w and 2w + 1, so a word load keeps 16-bit access out of the hot loop.
#define KV_ELEM uint
#define KV_LOAD(buf, e) unpackHalf2x16(buf.data[(e) >> 1])[(e) & 1]
#else
#define KV_ELEM float
#define KV_LOAD(buf, e) float(buf.data[e])
#endif

#ifndef ATTN_SPLIT
#error "ATTN_SPLIT must come from the build (limits.attn_split_len)"
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer QBuf {
    float data[];
} q_buf;

layout(std430, set = 0, binding = 1) readonly buffer KBuf {
    KV_ELEM data[];
} k_buf;

layout(std430, set = 0, binding = 2) readonly buffer VBuf {
    KV_ELEM data[];
} v_buf;

layout(std430, set = 0, binding = 3) writeonly buffer OutBuf {
    float data[];
} out_buf;

layout(push_constant) uniform Params {
    uint n_heads;
    uint n_kv_heads;
    uint head_dim;
    uint t_len;
} params;

shared float scores[ATTN_SPLIT];
shared float reduce_lds[64];

// -- main -------------------------------------------------------------------
void main() {
    uint h = gl_WorkGroupID.x;
    uint local = gl_LocalInvocationID.x;

    if (h >= params.n_heads) return;

    uint head_dim = params.head_dim;
    uint t_len = params.t_len;
    uint group_size = params.n_heads / params.n_kv_heads;
    uint kv_h = h / group_size;
    uint q_off = h * head_dim;
    float scale = 1.0 / sqrt(float(head_dim));

    // Pass 1: s_t = (q[h] . k[t, kv_h]) * scale.
    for (uint t = local; t < t_len; t += 64u) {
        uint k_off = t * params.n_kv_heads * head_dim + kv_h * head_dim;
        precise float s = 0.0;

        for (uint d = 0u; d < head_dim; ++d) {
            s += q_buf.data[q_off + d] * KV_LOAD(k_buf, k_off + d);
        }

        scores[t] = s * scale;
    }
    barrier();

    // Pass 2: m = max_t s_t, a lane partial and an LDS tree.
    float my_max = -3.402823466e+38;
    for (uint t = local; t < t_len; t += 64u) {
        if (scores[t] > my_max) {
            my_max = scores[t];
        }
    }

    reduce_lds[local] = my_max;
    barrier();
    if (local < 32u && reduce_lds[local + 32u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 32u];
    }
    barrier();
    if (local < 16u && reduce_lds[local + 16u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 16u];
    }
    barrier();
    if (local < 8u && reduce_lds[local + 8u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 8u];
    }
    barrier();
    if (local < 4u && reduce_lds[local + 4u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 4u];
    }
    barrier();
    if (local < 2u && reduce_lds[local + 2u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 2u];
    }
    barrier();
    if (local < 1u && reduce_lds[local + 1u] > reduce_lds[local]) {
        reduce_lds[local] = reduce_lds[local + 1u];
    }
    barrier();

    // Every lane reads slot 0 before pass 3 writes the tree slots.
    float vec_max = reduce_lds[0];
    barrier();

    // Pass 3: e_t = exp(s_t - m) in `scores`, then L = sum_t e_t, a lane partial and an LDS tree.
    float my_sum = 0.0;
    for (uint t = local; t < t_len; t += 64u) {
        float e = exp(scores[t] - vec_max);
        scores[t] = e;
        my_sum += e;
    }

    reduce_lds[local] = my_sum;
    barrier();
    if (local < 32u) reduce_lds[local] += reduce_lds[local + 32u];
    barrier();
    if (local < 16u) reduce_lds[local] += reduce_lds[local + 16u];
    barrier();
    if (local < 8u) reduce_lds[local] += reduce_lds[local + 8u];
    barrier();
    if (local < 4u) reduce_lds[local] += reduce_lds[local + 4u];
    barrier();
    if (local < 2u) reduce_lds[local] += reduce_lds[local + 2u];
    barrier();
    if (local < 1u) reduce_lds[local] += reduce_lds[local + 1u];
    barrier();

    float vec_sum = reduce_lds[0];
    float inv_sum = 1.0 / vec_sum;

    // Pass 4: p_t = e_t / L, in place in `scores`.
    for (uint t = local; t < t_len; t += 64u) {
        scores[t] *= inv_sum;
    }
    barrier();

    // Pass 5: out[h, d] = sum_t p_t * v[t, kv_h, d]. A head of 128 elements gives a lane two.
    uint out_off = h * head_dim;
    for (uint d = local; d < head_dim; d += 64u) {
        precise float sum = 0.0;

        for (uint t = 0u; t < t_len; ++t) {
            uint v_off = t * params.n_kv_heads * head_dim + kv_h * head_dim;
            sum += scores[t] * KV_LOAD(v_buf, v_off + d);
        }

        out_buf.data[out_off + d] = sum;
    }
}
