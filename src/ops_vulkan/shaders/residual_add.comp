// residual_add: dst[i] += x[i], the residual connection of a transformer layer.
//
// What
//   The connection wraps the attention block and the FFN block of every layer. Binding 1 is
//   read-write, so one buffer is both the accumulator and the destination.
//
// Hardware
//   Lane i owns element i. 256 lanes are 8 wave32 waves, and the grid is (ceil(n / 256), 1, 1).
//   n is a model hidden dim, 576 to 4096 across the bench models, so few workgroups run.
//
// Numerics
//   Bit-exact: the kernel does one IEEE-754 add per element, with no reduction order and no FMA
//   candidate.
//
// Bindings
//   0     readonly   f32  x[n]
//   1     readwrite  f32  dst[n]
//   push  uint n

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) buffer DstBuf {
    float data[];
} dst_buf;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    dst_buf.data[i] = dst_buf.data[i] + x_buf.data[i];
}
