// Residual add in place: dst[i] = dst[i] + x[i] for i in 0..n. It is the residual
// connection that wraps the attention block and the FFN block of every
// transformer layer. Binding 1 is read-write, so the same buffer is both the
// accumulator of the residual stream and the destination.
//
//   binding 0  readonly  f32 x[n]
//   binding 1  readwrite f32 dst[n]
//   push       uint n
//
// Lane i owns element i. local_size_x = 256 is 8 RDNA2 wave32 waves, and the
// dispatch is ceil(n / 256) workgroups. n is a model hidden dim, 576 to 4096
// across the bench models, so only a few workgroups run.
//
// Bit-exact against the CPU reference: the kernel does one IEEE-754 add per
// element, with no reduction order and no FMA candidate.

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer XBuf {
    float data[];
} x_buf;

layout(std430, set = 0, binding = 1) buffer DstBuf {
    float data[];
} dst_buf;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;
    dst_buf.data[i] = dst_buf.data[i] + x_buf.data[i];
}
