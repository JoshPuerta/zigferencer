// swiglu: dst[i] = silu(gate[i]) * up[i], the activation between the two FFN matmuls.
//
// What
//   silu(x) = x / (1 + exp(-x)). The gate projection and the up projection write two separate
//   buffers, so the activation is a pure per-element pass over them.
//
// Hardware
//   Lane i owns element i. 256 lanes are 8 wave32 waves, and the grid is (ceil(n / 256), 1, 1).
//
// Numerics
//   Tolerance: `Swiglu` declares `.relative = 1e-5`. The GPU `exp` does not round the same as the
//   CPU `std.math.exp`. The kernel has no reduction, so no summation order applies.
//
// Bindings
//   0     readonly   f32  gate[n]
//   1     readonly   f32  up[n]
//   2     writeonly  f32  dst[n]
//   push  uint n

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// -- bindings ---------------------------------------------------------------
layout(std430, set = 0, binding = 0) readonly buffer GateBuf {
    float data[];
} gate_buf;

layout(std430, set = 0, binding = 1) readonly buffer UpBuf {
    float data[];
} up_buf;

layout(std430, set = 0, binding = 2) writeonly buffer DstBuf {
    float data[];
} dst_buf;

layout(push_constant) uniform Params {
    uint n;
} params;

// -- main -------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= params.n) return;

    float g = gate_buf.data[i];
    float u = up_buf.data[i];
    float silu = g / (1.0 + exp(-g));
    dst_buf.data[i] = silu * u;
}
